  "url": "https://crossfitlamola.com/",
  "logo": "https://crossfitlamola.com/assets/logo-full.png",
  "image": [
    "https://crossfitlamola.com/assets/hero-still.webp",
    "https://crossfitlamola.com/assets/elbox-zona-wod.webp",
    "https://crossfitlamola.com/assets/team.webp"
