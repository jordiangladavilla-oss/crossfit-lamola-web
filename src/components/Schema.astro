---

<script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
{type === 'home' && <script type="application/ld+json" set:html={JSON.stringify(homeExtras)} />}
{type === 'home' && <script type="application/ld+json" set:html={JSON.stringify(heroVideo)} />}
{type === 'contacte' && <script type="application/ld+json" set:html={JSON.stringify(contactPage)} />}
{type === 'el-box' && <script type="application/ld+json" set:html={JSON.stringify(aboutPage)} />}
{type === 'el-box' && <script type="application/ld+json" set:html={JSON.stringify(homeExtras)} />}
