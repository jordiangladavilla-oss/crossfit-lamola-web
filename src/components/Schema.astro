// Dades estructurades del negoci (LocalBusiness) + extres per pàgina. Trilingüe: els textos
// surten del mapa L segons l'idioma de la URL (abans tot era en català també a /es i /en).
import { priceRange, PRICES } from '../data/pricing'
import { getLangFromUrl } from '../i18n/utils'

interface Props {
  // 'classes' | 'tarifes' | 'horari' | 'agenda' no afegeixen res: només el bloc base.
  type?: 'base' | 'home' | 'classes' | 'tarifes' | 'contacte' | 'el-box' | 'horari' | 'agenda'
}

const { type = 'base' } = Astro.props
const lang = getLangFromUrl(Astro.url) as 'ca' | 'es' | 'en'
const pfx = lang === 'ca' ? '' : `/${lang}`

