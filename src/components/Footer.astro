---
import { getLangFromUrl, useTranslations } from '../i18n/utils'
import { SITE } from '../data/site'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const prefix = lang === 'ca' ? '' : `/${lang}`

const currentYear = new Date().getFullYear()

const langLabel = { ca: 'Català', es: 'Español', en: 'English' }[lang]
const manageCookiesLabel = { ca: 'Gestionar cookies', es: 'Gestionar cookies', en: 'Manage cookies' }[lang]
---

<footer>
  <div class="foot-top">
    <div>
      <div class="foot-mark">
        <img srcset="/assets/logo-full.png-800.webp 800w, /assets/logo-full.png-1200.webp 1200w, /assets/logo-full.png 1674w" sizes="(min-width: 1100px) 50vw, (min-width: 700px) 60vw, 100vw" src="/assets/logo-full.png-1200.webp" alt="CrossFit La Mola. Build strength together" width="1280" height="199" loading="lazy">
      </div>
    </div>
    <div class="foot-col">
      <h3>{t('footer.nav')}</h3>
      <a href={`${prefix}/classes`}>{t('nav.classes')}</a>
      <a href={`${prefix}/horari`}>{t('nav.horari')}</a>
      <a href={`${prefix}/tarifes`}>{t('nav.tarifes')}</a>
      <a href={`${prefix}/el-box`}>{t('nav.elbox')}</a>
      <a href={`${prefix}/agenda`}>{t('nav.agenda')}</a>
      <a href={`${prefix}/contacte`}>{t('nav.contacte')}</a>
    </div>
    <div class="foot-col">
      <h3>{t('footer.services')}</h3>
      <a href={`${prefix}/recovery`}>{t('nav.recovery')}</a>
      <a href={`${prefix}/opositors`}>{t('nav.opositors')}</a>
      <a href={`${prefix}/partners`}>{t('nav.partners')}</a>
    </div>
    <div class="foot-col">
      <h3>{t('footer.location')}</h3>
      <p>{SITE.address.street}</p>
      <p>{SITE.address.postalCode} {SITE.address.city} · {SITE.address.province}</p>
      <a href={SITE.maps} target="_blank" rel="noopener">{t('footer.directions')} →</a>
    </div>
    <div class="foot-col">
      <h3>{t('nav.contacte')}</h3>
      <a href={SITE.whatsapp}>{SITE.phone}</a>
      <a href={SITE.instagram} target="_blank" rel="noopener">{SITE.instagramHandle}</a>
    </div>
  </div>
  <div class="foot-bottom">
    <span>© {currentYear} CrossFit La Mola.</span>
    <span><a href={`${prefix}/avis-legal`}>{t('footer.legal')}</a> · <a href={`${prefix}/privacitat`}>{t('footer.privacy')}</a> · <a href={`${prefix}/cookies`}>{t('footer.cookies')}</a> · <a href="#" data-cookie-manage>{manageCookiesLabel}</a></span>
    <span>{t('footer.photoCredit')} <a href="https://www.pinyacolada.studio/" target="_blank" rel="noopener">Piña Colada Studio</a> · {t('footer.madein')} · {langLabel}</span>
  </div>
</footer>
