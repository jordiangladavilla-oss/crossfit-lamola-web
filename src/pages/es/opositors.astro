---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import Schema from '../../components/Schema.astro'

const WA = 'https://wa.me/34699196531?text=%C2%A1Hola!%20Preparo%20las%20oposiciones%20de%20Bombers%20de%20la%20Generalitat%20(conv.%2081%2F26)%20y%20quiero%20informaci%C3%B3n%20de%20la%20cuota%20de%20opositores%20de%20La%20Mola.'
---

<Layout
  title="Preparación física para oposiciones en Terrassa · Bomberos 2026 y Mossos · CrossFit La Mola"
  description="Preparación física para oposiciones en Terrassa: sesiones semanales de circuito de la prueba de Bomberos de la Generalitat 2026 (convocatoria 81/26) y entrenamiento libre. También Bomberos de Barcelona y Mossos d'Esquadra. Franja lu–vi 11:30–15:30 y domingos. Cuota 55€/mes, drop-in 15€."
  ogImage="/assets/opositors-hero.webp"
>
  <Schema type="base" slot="head" />
  <Breadcrumb items={[{name: "Oposiciones"}]} lang="es" slot="head" />
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/opositors-hero.webp" fetchpriority="high" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Preparación física para oposiciones · CrossFit La Mola",
      "serviceType": "Entrenamiento para pruebas físicas de oposiciones",
      "provider": { "@id": "https://crossfitlamola.com/#organization" },
      "areaServed": {"@type": "City", "name": "Terrassa"},
      "audience": {"@type": "Audience", "audienceType": "Opositores a Bombers de la Generalitat de Catalunya (convocatoria 81/26), Bomberos del Ayuntamiento de Barcelona y Mossos d'Esquadra"},
      "description": "Franja de entrenamiento para opositores de lunes a viernes de 11:30 a 15:30 y domingos de 9:30 a 11:30. Sesiones semanales de circuito de las dos simulaciones de incendio de la prueba física de Bombers de la Generalitat 2026 (Resolución ISP/3218/2026) y entrenamiento libre el resto de días, con coaches en la sala. Programación personalizada a consultar. El rescate acuático se prepara en piscina.",
      "offers": [
        {
          "@type": "Offer",
          "name": "Cuota opositores",
          "description": "Uso ilimitado de las instalaciones dentro de la franja: de lunes a viernes de 11:30 a 15:30 y domingos de 9:30 a 11:30. Hay que acreditar la inscripción a la convocatoria.",
          "priceCurrency": "EUR",
          "price": "55.00",
          "availability": "https://schema.org/InStock",
          "url": "https://crossfitlamola.com/es/opositors"
        },
        {
          "@type": "Offer",
          "name": "Drop-in opositores · 1 día",
          "description": "Un día de acceso a la franja de opositores y al material del box, sin cuota mensual.",
          "priceCurrency": "EUR",
          "price": "15.00",
          "availability": "https://schema.org/InStock",
          "url": "https://crossfitlamola.com/es/opositors"
        },
        {
          "@type": "Offer",
          "name": "Drop-in opositores + sauna",
          "description": "Un día de entrenamiento en la franja de opositores más una sesión de sauna para la recuperación (suplemento de 10€ sobre el drop-in).",
          "priceCurrency": "EUR",
          "price": "25.00",
          "availability": "https://schema.org/InStock",
          "url": "https://crossfitlamola.com/es/opositors"
        }
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {"@type": "Question", "name": "¿Qué se puede preparar en el box de la prueba física de Bombers de la Generalitat 2026?", "acceptedAnswer": {"@type": "Answer", "text": "La convocatoria 81/26 (Resolución ISP/3218/2026) tiene tres simulaciones de intervención cronometradas. Las dos simulaciones de incendio (vegetación y estructural) se preparan en el box: se monta el circuito en sesiones semanales dentro de la franja. La tercera, el rescate acuático, se hace en piscina y no se puede preparar en el box; desde aquí solo se trabaja la base aeróbica, la tracción y el core."}},
        {"@type": "Question", "name": "¿Hay entrenamiento dirigido o programación?", "acceptedAnswer": {"@type": "Answer", "text": "El entrenamiento dentro de la franja es libre, con sesiones semanales de circuito. Los coaches están en la sala y, si un día quieres que te cronometren o te revisen la ejecución, pídelo. Si quieres una programación personalizada para tu convocatoria, consúltanos."}},
        {"@type": "Question", "name": "¿Cuándo son las pruebas físicas de Bomberos 2026?", "acceptedAnswer": {"@type": "Answer", "text": "Las fechas aún no se han publicado. La prueba física va después del test de conocimientos. Las inscripciones a la convocatoria 81/26 son telemáticas en tràmits.gencat.cat, durante 10 días hábiles a partir del 16 de septiembre de 2026. Consulta siempre las bases oficiales."}},
        {"@type": "Question", "name": "¿Quién puede acceder a la cuota de opositores?", "acceptedAnswer": {"@type": "Answer", "text": "Cualquier persona inscrita en una convocatoria de oposiciones con pruebas físicas: Bombers de la Generalitat de Catalunya, Bomberos del Ayuntamiento de Barcelona (SPEIS), Mossos d'Esquadra u otros cuerpos. Hay que acreditar la inscripción a la convocatoria para darse de alta."}},
        {"@type": "Question", "name": "¿Qué horario tiene la franja de opositores?", "acceptedAnswer": {"@type": "Answer", "text": "De lunes a viernes de 11:30 a 15:30, y domingos de 9:30 a 11:30. Dentro de esta franja el uso de las instalaciones y el material es ilimitado."}},
        {"@type": "Question", "name": "¿Cuánto cuesta la cuota de opositores?", "acceptedAnswer": {"@type": "Answer", "text": "55€ al mes, IVA incluido, con uso ilimitado dentro de la franja. También hay un drop-in de un día por 15€, y por 10€ más se puede añadir una sesión de sauna (25€ en total)."}},
        {"@type": "Question", "name": "Quiero preparar las oposiciones y también hacer clases en el box. ¿Qué cuota necesito?", "acceptedAnswer": {"@type": "Answer", "text": "La cuota de opositores (55€/mes) da acceso solo a la franja de 11:30 a 15:30 entre semana y domingos por la mañana. Si además quieres hacer alguna de las clases del box (WOD, Hybrid Club, Weightlifting, Strength Club…) o entrenar en otros horarios, necesitas la cuota Ilimitada, que incluye también el espacio y el material de opositores."}},
        {"@type": "Question", "name": "Ya soy socix de CrossFit La Mola. ¿Puedo usar el espacio de opositores?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Con la cuota Ilimitada puedes acceder al espacio y al material de opositores dentro de la franja, sin ningún suplemento."}}
      ]
    }
    </script>
  </Fragment>

  <style>
    .hero-acts{ display:flex; flex-wrap:wrap; gap:16px 24px; align-items:center; margin-top:30px; }
    .hero-acts .hero-cta{ align-self:auto; }

    .cossos{ display:grid; gap:1px; margin-top:60px; background:var(--line); }
    @media(min-width:900px){ .cossos{ grid-template-columns:repeat(3,1fr);} }
    .cos{ background:var(--ink); padding:clamp(28px,3vw,40px); display:flex; flex-direction:column; gap:14px; }
    .cos .tag{ font-family:var(--f-mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent-hi);}
    .cos h3{ font-family:var(--f-display); font-weight:500; font-size:clamp(22px,2.2vw,28px); letter-spacing:-0.025em; line-height:1.02; margin:0; color:var(--bone);}
    .cos h3 em{ font-family:var(--f-serif); font-style:italic; font-weight:300; color:var(--accent-hi);}
    .cos p{ font-family:var(--f-serif); font-size:16px; line-height:1.55; color:var(--bone-2); margin:0;}

    .regla{ margin-top:48px; padding:26px 30px; border:1px solid var(--line); display:grid; gap:10px; }
    .regla .tag{ font-family:var(--f-mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent-hi);}
    .regla p{ font-family:var(--f-serif); font-size:16px; line-height:1.55; color:var(--bone-2); margin:0; max-width:75ch;}
    .mat{ margin-top:48px; padding:26px 30px; border:1px solid var(--line); display:grid; gap:20px; }
    .mat .tag{ font-family:var(--f-mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent-hi);}
    .mat-cols{ display:grid; gap:22px 40px; grid-template-columns:1fr; }
    @media(min-width:760px){ .mat-cols{ grid-template-columns:1fr 1fr;} }
    .mat h4{ font-family:var(--f-display); font-weight:500; font-size:clamp(18px,1.8vw,22px); letter-spacing:-0.02em; line-height:1.1; margin:0 0 12px; color:var(--bone);}
    .mat ul{ margin:0; padding-left:18px; font-family:var(--f-serif); font-size:16px; line-height:1.6; color:var(--bone-2);}
    .mat li + li{ margin-top:4px;}
    .font{ margin-top:22px; font-family:var(--f-mono); font-size:11px; letter-spacing:.06em; line-height:1.7; color:var(--bone-3);}
    .font a{ color:var(--bone-3); border-bottom:1px solid var(--line-strong);}
    .font a:hover{ color:var(--accent-hi); border-color:var(--accent-hi);}

    .conds{ display:grid; gap:0; margin-top:60px; border-top:1px solid var(--line-ink);}
    .conds > div{ display:grid; grid-template-columns:1fr; gap:8px 24px; padding:24px 0; border-bottom:1px solid var(--line-ink); align-items:baseline;}
    @media(min-width:760px){ .conds > div{ grid-template-columns:200px 1fr auto;} }
    @media(max-width:759px){ .conds .p{ display:none;} }
    .conds .label{ font-family:var(--f-mono); font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:var(--accent-ink);}
    .conds h4{ font-family:var(--f-display); font-weight:500; font-size:clamp(20px,2vw,26px); letter-spacing:-0.02em; margin:0; color:var(--bone-ink);}
    .conds p{ font-family:var(--f-serif); font-size:16px; line-height:1.55; color:var(--bone-ink); opacity:.75; margin:6px 0 0; max-width:65ch;}
    .conds .p{ font-family:var(--f-display); font-weight:500; font-size:clamp(22px,2.4vw,30px); letter-spacing:-0.02em; color:var(--bone-ink);}

    .faq{ display:grid; gap:0; border-top:1px solid var(--line); margin-top:60px;}
    .faq details{ border-bottom:1px solid var(--line); padding:22px 0;}
    .faq summary{ list-style:none; cursor:pointer; display:flex; justify-content:space-between; align-items:center; gap:20px; font-family:var(--f-display); font-weight:500; font-size:clamp(19px,2vw,24px); letter-spacing:-0.02em; color:var(--bone);}
    .faq summary::-webkit-details-marker{ display:none;}
    .faq summary::after{ content:"+"; font-family:var(--f-display); font-weight:400; font-size:24px; color:var(--accent-hi); transition:transform .3s;}
    .faq details[open] summary::after{ transform:rotate(45deg);}
    .faq p{ font-family:var(--f-serif); font-size:17px; line-height:1.55; color:var(--bone-2); margin:14px 0 0; max-width:60ch;}
  </style>

  <Nav currentPage="/es/opositors" />

  <section class="page-hero">
    <div class="bg" style="background-image:url('/assets/opositors-hero.webp')"></div>
    <div class="inner">
      <div class="crumb"><a href="/es">Inicio</a><span>/</span><span>Oposiciones</span></div>
      <div class="kicker"><span>Bomberos · Convocatoria 81/26 abierta</span><span class="bar"></span><span>Mossos d'Esquadra</span></div>
      <h1>Preparación física<br>para <em class="serif">oposiciones</em><span class="dot">.</span></h1>
      <p class="sub">Una franja <strong>para opositores</strong> en Terrassa: sesiones semanales de circuito de la prueba de Bomberos 2026 y entrenamiento libre el resto de días, con el mismo criterio que en todo el box. También para Bomberos de Barcelona y Mossos d'Esquadra. De lunes a viernes de 11:30 a 15:30 y domingos de 9:30 a 11:30. Cuota de 55€/mes o drop-in de 15€.</p>
      <div class="hero-acts">
        <a class="hero-cta" href={WA} target="_blank" rel="noopener" data-wa="hero">Escríbenos por WhatsApp<span class="arr"></span></a>
        <a class="btn-ghost" href="#opo-form">o déjanos tus datos</a>
      </div>
    </div>
  </section>

  <section class="sec ink">
    <div class="inner">
      <div class="eyebrow reveal"><span class="num">01 —</span><span>Qué trabajamos</span></div>
      <div style="height:24px"></div>
      <div class="sec-head">
        <h2 class="h-xl reveal">Circuito semanal<br>y entrenamiento libre<span class="dot">.</span></h2>
        <p class="lead reveal">La prueba física de Bombers de la Generalitat 2026 (convocatoria 81/26) tiene tres simulaciones de intervención cronometradas. Las dos de incendio se preparan en el box. La tercera, el rescate acuático, es en piscina.</p>
      </div>

      <div class="cossos reveal-stagger">
        <div class="cos" style="--i:0">
          <span class="tag">01 · Circuito</span>
          <h3>Sesiones <em>semanales</em></h3>
          <p>Cada semana montamos el circuito de las simulaciones de incendio dentro de la franja. Se entrena tal como se hará el día de la prueba: encadenado y con cronómetro.</p>
        </div>
        <div class="cos" style="--i:1">
          <span class="tag">02 · Franja</span>
          <h3>Entrenamiento <em>libre</em></h3>
          <p>El resto de días, entrenamiento libre dentro de la franja con todo el material del box. Los coaches están en la sala: si quieres que te revisen la ejecución o te cronometren un intento, pídelo.</p>
        </div>
        <div class="cos" style="--i:2">
          <span class="tag">03 · Modo oposición</span>
          <h3>Un intento, <em>a la primera</em></h3>
          <p>En la prueba solo hay un intento y no se permiten guantes, magnesio, calleras, rodilleras, muñequeras, fajas ni cinturones. Entrénalo igual.</p>
        </div>
      </div>


      <div class="mat reveal">
        <span class="tag">Material del circuito disponible en el box</span>
        <div class="mat-cols">
          <div>
            <h4>Ejercicio 1 · Incendio de vegetación</h4>
            <ul>
              <li>Slam ball de 6 kg (pelota medicinal que no rebota)</li>
              <li>Cono alto para el giro de 180° al final de la recta de 20 m</li>
            </ul>
          </div>
          <div>
            <h4>Ejercicio 2 · Incendio estructural</h4>
            <ul>
              <li>Barra de equilibrio de 3 m (21,5 cm de altura y 10 cm de ancho)</li>
              <li>Kettlebells de 12 kg y discos bumper de 10 kg</li>
              <li>Cajón para los 10 step-ups</li>
              <li>Arrastre del maniquí con saco de 50 kg, el mismo peso que en la prueba. También worm de 75 kg con asas</li>
              <li>Trineo de 95 kg: pull con cuerda y push, 10 m cada tramo</li>
            </ul>
          </div>
        </div>
      </div>
      <p class="font reveal">Fuente: <a href="https://portaldogc.gencat.cat/utilsEADOP/PDF/9751/2170230.pdf" target="_blank" rel="noopener">Resolución ISP/3218/2026 (DOGC núm. 9751, 15.9.2026)</a>. Inscripciones en tràmits.gencat.cat durante 10 días hábiles a partir del 16 de septiembre. Las fechas de la prueba física aún no se han publicado. Las bases oficiales son la referencia.</p>

      <div class="regla reveal">
        <span class="tag">Bomberos de Barcelona · Mossos d'Esquadra · otros cuerpos</span>
        <p>La franja también es para quien prepara Bomberos del Ayuntamiento de Barcelona (SPEIS), Mossos d'Esquadra o cualquier otra convocatoria con pruebas físicas. El material y la base de fuerza y capacidad aeróbica son los mismos. Consulta las bases de tu convocatoria y, si tienes dudas sobre qué trabajar, pregúntanos.</p>
      </div>

    </div>
  </section>

  <section class="sec bone">
    <div class="inner">
      <div class="eyebrow reveal"><span class="num">02 —</span><span>Condiciones</span></div>
      <div style="height:24px"></div>
      <h2 class="h-xl reveal">Cuota mensual<br>o drop-in de un día<span class="dot">.</span></h2>

      <div class="conds reveal">
        <div><span class="label">01 · Cuota</span><div><h4>55€/mes · IVA incluido</h4><p>Uso ilimitado de las instalaciones y el material dentro de la franja de opositores.</p></div><span class="p">55€<span style="font-family:var(--f-mono); font-size:11px; color:var(--muted-ink); margin-left:6px;">/mes</span></span></div>
        <div><span class="label">02 · Franja</span><div><h4>Lunes a viernes · 11:30–15:30</h4><p>Cuatro horas diarias entre semana con todo el material del box a disposición. Y también los <strong>domingos de 9:30 a 11:30</strong>.</p></div><span class="p">6<span style="font-family:var(--f-mono); font-size:11px; color:var(--muted-ink); margin-left:6px;">días/sem.</span></span></div>
        <div><span class="label">03 · Circuito</span><div><h4>Sesiones semanales</h4><p>Cada semana montamos el circuito de las simulaciones de incendio dentro de la franja. El resto de días, entrenamiento libre.</p></div></div>
        <div><span class="label">04 · Programación</span><div><h4>Personalizada · consúltanos</h4><p>Si quieres una programación adaptada a tu convocatoria y a tu punto de partida, consúltanos.</p></div></div>
        <div><span class="label">05 · Acreditación</span><div><h4>Justificante de inscripción</h4><p>Para acceder a esta tarifa hay que acreditar la inscripción a la convocatoria de oposiciones (justificante o resguardo de inscripción).</p></div></div>
        <div><span class="label">06 · Drop-in</span><div><h4>Un día · 15€</h4><p>Ven el día del circuito y ponte a prueba, sin cuota mensual.</p></div><span class="p">15€<span style="font-family:var(--f-mono); font-size:11px; color:var(--muted-ink); margin-left:6px;">/día</span></span></div>
        <div><span class="label">07 · Sauna</span><div><h4>Recuperación · +10€</h4><p>Añade una sesión de sauna al drop-in y haz un día completo de entrenamiento y recuperación: 25€ en total.</p></div><span class="p">+10€<span style="font-family:var(--f-mono); font-size:11px; color:var(--muted-ink); margin-left:6px;">/sesión</span></span></div>
      </div>
    </div>
  </section>

  <section class="sec ink">
    <div class="inner">
      <div class="eyebrow reveal"><span class="num">03 —</span><span>Preguntas frecuentes</span></div>
      <div style="height:24px"></div>
      <h2 class="h-xl reveal" style="color:var(--bone)">Dudas<br>habituales<span class="dot">.</span></h2>

      <div class="faq reveal" style="margin-top:52px;">
        <details><summary>¿Qué se puede preparar en el box de la prueba de Bomberos 2026?</summary><p>La convocatoria 81/26 tiene <strong>tres simulaciones cronometradas</strong>. Las dos <strong>simulaciones de incendio</strong> (vegetación y estructural) se preparan en el box: montamos el circuito en sesiones semanales dentro de la franja. El <strong>rescate acuático</strong> se hace en piscina y no se puede preparar aquí: desde el box solo aportamos base aeróbica, tracción y core.</p></details>
        <details><summary>¿Hay entrenamiento dirigido o programación?</summary><p>El entrenamiento dentro de la franja es <strong>libre</strong>, con <strong>sesiones semanales de circuito</strong>. Los coaches están en la sala y, si un día quieres que te cronometren o te revisen la ejecución, pídelo. Si quieres una <strong>programación personalizada</strong> para tu convocatoria, consúltanos.</p></details>
        <details><summary>¿Cuándo son las pruebas físicas?</summary><p>Las fechas <strong>aún no se han publicado</strong>. La física va después del test de conocimientos. Las inscripciones a la convocatoria 81/26 son en tràmits.gencat.cat durante 10 días hábiles a partir del 16 de septiembre. Consulta siempre las bases oficiales.</p></details>
        <details><summary>¿Quién puede acceder a la cuota de opositores?</summary><p>Cualquier persona inscrita en una convocatoria con pruebas físicas: <strong>Bombers de la Generalitat</strong>, <strong>Bomberos de Barcelona (SPEIS)</strong>, <strong>Mossos d'Esquadra</strong> u otros cuerpos. Hay que acreditar la inscripción para darse de alta.</p></details>
        <details><summary>¿Puedo venir cada día?</summary><p>Sí. El uso dentro de la franja es <strong>ilimitado</strong>: de lunes a viernes de 11:30 a 15:30, y domingos de 9:30 a 11:30.</p></details>
        <details><summary>Quiero preparar las oposiciones y también hacer clases en el box. ¿Qué cuota necesito?</summary><p>La cuota de opositores (55€/mes) cubre solo la franja de 11:30 a 15:30 entre semana y domingos por la mañana. Si además quieres hacer alguna de las clases del box (WOD, Hybrid Club, Weightlifting, Strength Club…) o entrenar en otros horarios, necesitas la <strong>cuota Ilimitada</strong>, que incluye también el espacio y el material de opositores.</p></details>
        <details><summary>Ya soy socix de CrossFit La Mola. ¿Puedo usar el espacio de opositores?</summary><p>Sí. Con la <strong>cuota Ilimitada</strong> puedes acceder al espacio y al material de opositores dentro de la franja, sin ningún suplemento.</p></details>
        <details><summary>¿Puedo venir solo un día a ponerme a prueba?</summary><p>Sí. El <strong>drop-in</strong> de opositores cuesta <strong>15€</strong> e incluye un día de acceso a la franja y al material. Ven el día del circuito y ponte a prueba. Si además quieres recuperar bien y aprovechar los beneficios de la sauna, puedes abonar <strong>10€ más</strong> y hacer un día completo de entrenamiento y recuperación: 25€ en total.</p></details>
      </div>
    </div>
  </section>

  <section class="cta-block">
    <div class="bg" style="background-image:url('/assets/hero-climb.jpg')"></div>
    <div class="inner">
      <div class="eyebrow reveal" style="color:var(--bone-3)"><span class="num" style="color:var(--accent-hi)">04 —</span><span>Empezamos</span></div>
      <h2 class="h-hero reveal">La plaza se<br>prepara <em class="serif">hoy</em><span class="dot">.</span></h2>
      <p class="reveal">Nos dices qué convocatoria preparas y te contactamos con toda la información. O ven a ver el box con el justificante de inscripción.</p>
      <form id="opo-form" class="reveal" style="display:grid; gap:24px; max-width:560px;">
        <input type="text" name="website" style="position:absolute;left:-9999px;" tabindex="-1" autocomplete="off" aria-hidden="true" aria-label="Honeypot anti-spam">
        <div class="form-row two">
          <div class="field"><label for="o-name">Nombre</label><input id="o-name" type="text" name="name" required aria-required="true" placeholder="¿Cómo te llamas?"></div>
          <div class="field"><label for="o-phone">Teléfono</label><input id="o-phone" type="tel" name="phone" required aria-required="true" placeholder="629 ..."></div>
        </div>
        <div class="field"><label for="o-prep">¿Qué oposición preparas?</label>
          <select id="o-prep" name="prep">
            <option>Bombers de la Generalitat (conv. 81/26)</option><option>Bomberos de Barcelona (SPEIS)</option><option>Mossos d'Esquadra</option><option>Otra convocatoria</option>
          </select>
        </div>
        <div class="field"><label for="o-note">¿Algún comentario? (opcional)</label><input id="o-note" type="text" name="note" placeholder="Convocatoria, fechas de las pruebas, dudas..."></div>
        <div class="actions" style="margin-top:0;">
          <button type="submit" class="form-submit" id="opo-submit">Quiero información<span style="display:inline-block; width:20px; height:1px; background:currentColor;"></span></button>
          <a class="btn-ghost" href={WA} target="_blank" rel="noopener" data-wa="form">o por WhatsApp</a>
        </div>
        <div id="opo-msg" style="display:none; padding:20px; border-radius:8px; font-family:var(--f-display);"></div>
      </form>
    </div>
  </section>

  <Footer />

<script>
  const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwHm_4Rwt_x9RN5q1PEKxTzXj587hgKYp70WqyNA9DpbETdy-dcUPt2n3YtaZ7KFJinww/exec';

  function getSource() {
    const params = new URLSearchParams(window.location.search);
    const utm = params.get('utm_source');
    if (utm) return utm;
    const from = params.get('from');
    if (from) return from;
    return 'web';
  }

  document.querySelectorAll('[data-wa]').forEach((a) => {
    a.addEventListener('click', () => {
      if (typeof gtag !== 'undefined') {
        gtag('event', 'whatsapp_click', { event_category: 'contact', event_label: 'Opositors · ' + a.dataset.wa });
      }
    });
  });

  document.getElementById('opo-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = document.getElementById('opo-submit');
    const msg = document.getElementById('opo-msg');
    const btnText = btn.innerHTML;

    btn.innerHTML = 'Enviando...';
    btn.disabled = true;
    msg.style.display = 'none';

    const source = getSource();
    const data = {
      origen: 'Opositors (' + source + ')',
      name: form.name.value,
      email: '',
      phone: form.phone.value,
      disc: 'Oposicions · ' + form.prep.value,
      level: '',
      when: '',
      note: form.note.value,
      website: form.website.value
    };

    try {
      await fetch(SCRIPT_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      msg.style.display = 'block';
      msg.style.background = 'var(--accent-ink)';
      msg.style.color = 'var(--bone)';
      msg.innerHTML = '<strong>¡Gracias!</strong> Hemos recibido tus datos. Te contactamos pronto.';
      form.reset();

      if (typeof gtag !== 'undefined') {
        gtag('event', 'generate_lead', {
          event_category: 'forms',
          event_label: 'Opositors',
          value: 1
        });
      }
    } catch (err) {
      msg.style.display = 'block';
      msg.style.background = '#fee';
      msg.style.color = '#c00';
      msg.innerHTML = 'Error al enviar. Prueba por WhatsApp: <a href="https://wa.me/34699196531" style="color:#c00;">699 19 65 31</a>';
    }

    btn.innerHTML = btnText;
    btn.disabled = false;
  });
</script>
</Layout>
