---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import Schema from '../../components/Schema.astro'
import { PRICES, eur } from '../../data/pricing'

const WA = 'https://wa.me/34699196531?text=%C2%A1Hola!%20Preparo%20las%20oposiciones%20de%20Bombers%20de%20la%20Generalitat%20(conv.%2081%2F26)%20y%20quiero%20informaci%C3%B3n%20de%20la%20cuota%20de%20opositores%20de%20La%20Mola.'
const Q = eur(PRICES.opositors, 'es')
---

<Layout
  title="Oposiciones de Bomberos · Preparación física Terrassa"
  description="Preparación física para oposiciones en Terrassa: 3 clases dirigidas a la semana con los elementos de la prueba de Bomberos 2026, entrenamiento libre, simulacro mensual y sauna. 80€/mes."
  ogImage="/assets/og/og-opositors.jpg"
>
  <Schema type="base" slot="head" />
  <Breadcrumb items={[{name: "Oposiciones"}]} lang="es" slot="head" />
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/opositors-hero.webp" fetchpriority="high" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Preparación física para oposiciones · CrossFit La Mola",
      "serviceType": "Entrenamiento para pruebas físicas de oposiciones",
      "provider": { "@id": "https://crossfitlamola.com/#organization" },
      "areaServed": {"@type": "City", "name": "Terrassa"},
      "audience": {"@type": "Audience", "audienceType": "Opositores a Bombers de la Generalitat de Catalunya (convocatoria 81/26), Bomberos del Ayuntamiento de Barcelona"},
      "description": "Cuota para opositores en Terrassa: programación específica para las pruebas físicas, tres clases dirigidas a la semana (lunes, miércoles y viernes de 12:30 a 13:30: incendio de vegetación, incendio estructural y acondicionamiento físico general), tres sesiones de entrenamiento libre a la semana (lunes, miércoles y viernes de 10:30 a 15:30; martes y jueves de 11:30 a 15:30), grupo de WhatsApp, simulacro mensual cronometrado del circuito completo y una sesión de sauna al mes. Elementos de la prueba física de Bombers de la Generalitat 2026 (Resolución ISP/3218/2026). El rescate acuático se prepara en piscina. Reservas por la app Aimharder.",
      "offers": [
        {
          "@type": "Offer",
          "name": "Cuota opositores",
          "description": "Programación específica, tres clases dirigidas y tres sesiones de entrenamiento libre a la semana, grupo de WhatsApp, simulacro mensual y una sesión de sauna al mes. Sin matrícula con la primera alta. Grupos de más de cuatro personas: 10% de descuento el primer mes. Hay que acreditar la inscripción a la convocatoria.",
          "priceCurrency": "EUR",
          "price": "80.00",
          "availability": "https://schema.org/InStock",
          "url": "https://crossfitlamola.com/es/opositors"
        },
        {
          "@type": "Offer",
          "name": "Sauna ilimitada · add-on a la cuota de opositores",
          "description": "Acceso ilimitado a la sauna infrarroja de La Mola Recovery, añadido a la cuota de opositores.",
          "priceCurrency": "EUR",
          "price": "9.90",
          "availability": "https://schema.org/InStock",
          "url": "https://crossfitlamola.com/es/recovery"
        },
        {
          "@type": "Offer",
          "name": "Drop-in opositores · 1 día",
          "description": "Un día de acceso a la franja de entrenamiento libre de opositores y al material del box, sin cuota mensual.",
          "priceCurrency": "EUR",
          "price": "15.00",
          "availability": "https://schema.org/InStock",
          "url": "https://crossfitlamola.com/es/opositors"
        },
        {
          "@type": "Offer",
          "name": "Drop-in opositores + sauna",
          "description": "Un día de entrenamiento en la franja de opositores más una sesión de sauna para la recuperación (suplemento de 10€ sobre el drop-in).",
          "priceCurrency": "EUR",
          "price": "25.00",
          "availability": "https://schema.org/InStock",
          "url": "https://crossfitlamola.com/es/opositors"
        }
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {"@type": "Question", "name": "¿Qué se puede preparar en el box de la prueba de Bomberos 2026?", "acceptedAnswer": {"@type": "Answer", "text": "La convocatoria 81/26 tiene tres simulaciones cronometradas. Las dos de incendio (vegetación y estructural) se preparan en el box con el material del circuito. El rescate acuático se hace en piscina: desde el box solo aportamos base aeróbica, tracción y core."}},
        {"@type": "Question", "name": "¿Qué días hay clase dirigida?", "acceptedAnswer": {"@type": "Answer", "text": "Lunes, miércoles y viernes de 12:30 a 13:30. Cada semana: una sesión de incendio de vegetación, una de incendio estructural y una de acondicionamiento físico general. Se reservan por la app Aimharder."}},
        {"@type": "Question", "name": "¿Cuántos días puedo venir?", "acceptedAnswer": {"@type": "Answer", "text": "Hasta seis: tres clases dirigidas y tres sesiones de entrenamiento libre a la semana. Las franjas libres son lunes, miércoles y viernes de 10:30 a 15:30, y martes y jueves de 11:30 a 15:30."}},
        {"@type": "Question", "name": "¿Hay matrícula o permanencia?", "acceptedAnswer": {"@type": "Answer", "text": "No. Con la primera alta no cobramos matrícula y no hay permanencia. Si venís un grupo de más de cuatro personas, el primer mes tiene un 10% de descuento."}},
        {"@type": "Question", "name": "¿Quién puede acceder a la cuota de opositores?", "acceptedAnswer": {"@type": "Answer", "text": "Personas inscritas en una convocatoria de Bombers de la Generalitat o de Bomberos de Barcelona (SPEIS). Hay que acreditar la inscripción para darse de alta."}},
        {"@type": "Question", "name": "¿Cuándo son las pruebas físicas?", "acceptedAnswer": {"@type": "Answer", "text": "Las fechas aún no se han publicado. La física va después del test de conocimientos. Consulta siempre las bases oficiales de la convocatoria 81/26."}},
        {"@type": "Question", "name": "Quiero preparar las oposiciones y también hacer clases en el box. ¿Qué cuota necesito?", "acceptedAnswer": {"@type": "Answer", "text": "La cuota de opositores da acceso a las tres dirigidas y a las tres sesiones libres semanales dentro de las franjas del mediodía. Para hacer también las clases del box (WOD, Hybrid Club, Weightlifting, Strength Club…) o entrenar en otros horarios, necesitas la cuota Ilimitada, que incluye el espacio y el material de opositores."}},
        {"@type": "Question", "name": "Ya tengo cuota en CrossFit La Mola. ¿Puedo usar el espacio de opositores?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Con la cuota Ilimitada puedes acceder al espacio y al material de opositores dentro de la franja, sin ningún suplemento."}},
        {"@type": "Question", "name": "¿Puedo venir solo un día?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. El drop-in de opositores cuesta 15€ y da acceso un día a la franja libre y al material, sin cuota mensual. Con una sesión de sauna, 25€ en total. Escríbenos para reservar."}},
        {"@type": "Question", "name": "¿La sauna está incluida?", "acceptedAnswer": {"@type": "Answer", "text": "Sí, una sesión de 15 minutos al mes. Si quieres sauna ilimitada, puedes añadir La Mola Recovery a la cuota por 9,90€ al mes."}}
      ]
    }
    </script>
  </Fragment>

  <style>
    .hero-acts{ display:flex; flex-wrap:wrap; gap:16px 24px; align-items:center; margin-top:30px; }
    .hero-acts .hero-cta{ align-self:auto; }

    .incl-grid{ display:grid; gap:1px; margin-top:60px; background:var(--line); }
    @media(min-width:700px){ .incl-grid{ grid-template-columns:repeat(2,1fr);} }
    @media(min-width:1000px){ .incl-grid{ grid-template-columns:repeat(3,1fr);} }
    .incl{ background:var(--ink); padding:clamp(28px,3vw,40px); display:flex; flex-direction:column; gap:14px; }
    .incl .tag{ font-family:var(--f-mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent-hi);}
    .incl h3{ font-family:var(--f-display); font-weight:500; font-size:clamp(22px,2.4vw,30px); letter-spacing:-0.025em; line-height:1; margin:0; color:var(--bone);}
    .incl h3 em{ font-family:var(--f-serif); font-style:italic; font-weight:300; color:var(--accent-hi);}
    .incl p{ font-family:var(--f-serif); font-size:16px; line-height:1.55; color:var(--bone-2); margin:0;}

    /* 02 · Tarifa (fons bone): una sola targeta de preu + condicions */
    .tarifa{ display:grid; gap:40px; margin-top:60px; align-items:start; }
    @media(min-width:900px){ .tarifa{ grid-template-columns:minmax(0,460px) 1fr; gap:60px;} }
    .price{ background:var(--ink); padding:clamp(28px,3vw,40px); display:flex; flex-direction:column; gap:18px; color:var(--bone);}
    .price *{ color: inherit; }
    .price .tag{ font-family:var(--f-mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent-hi);}
    .price h3{ font-family:var(--f-display); font-weight:500; font-size:clamp(24px,2.6vw,32px); letter-spacing:-0.03em; line-height:.98; margin:0;}
    .price h3 em{ font-family:var(--f-serif); font-style:italic; font-weight:300; color:var(--accent-hi);}
    .price .num{ font-family:var(--f-display); font-weight:500; font-size:clamp(48px,6vw,72px); letter-spacing:-0.04em; line-height:1;}
    .price .num sup{ font-size:.4em; font-weight:500; vertical-align:.5em; margin-left:4px;}
    .price .per{ font-family:var(--f-mono); font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:var(--muted); margin-left:8px;}
    .price ul{ list-style:none; padding:0; margin:0; font-family:var(--f-serif); font-size:16.5px; line-height:1.55; display:grid; gap:10px;}
    .price ul li{ display:flex; gap:12px; align-items:baseline;}
    .price ul li::before{ content:""; width:6px; height:6px; background:var(--accent-hi); border-radius:50%; flex:none; transform:translateY(2px);}
    .terms{ list-style:none; margin:0; padding:0; display:grid; gap:0; border-top:1px solid var(--line-ink);}
    .terms li{ display:flex; gap:14px; align-items:baseline; padding:18px 0; border-bottom:1px solid var(--line-ink); font-family:var(--f-serif); font-size:17px; line-height:1.5; color:var(--bone-ink);}
    .terms li::before{ content:""; width:6px; height:6px; background:var(--accent-ink); border-radius:50%; flex:none; transform:translateY(-2px);}
    .terms strong{ font-weight:500;}

    /* 03 · La prova (fons ink, foto + material) */
    .prova{ display:grid; gap:40px; margin-top:60px; align-items:start; }
    @media(min-width:900px){ .prova{ grid-template-columns:1fr 1fr; gap:60px;} }
    .prova .pic{ margin:0; aspect-ratio:4/3; overflow:hidden; border:1px solid var(--line); background:#1a1712; }
    .prova .pic img{ width:100%; height:100%; object-fit:cover; display:block; }
    .prova .pic figcaption{ font-family:var(--f-mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--bone-3); padding:10px 0 0; }
    .mat{ border-top:1px solid var(--line); display:grid; gap:18px; padding-top:22px; }
    .mat .tag{ font-family:var(--f-mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent-hi);}
    .mat ul{ list-style:none; margin:0; padding:0; display:grid; gap:10px; font-family:var(--f-serif); font-size:16.5px; line-height:1.5; color:var(--bone-2);}
    @media(min-width:560px){ .mat ul{ grid-template-columns:1fr 1fr; gap:10px 28px;} }
    .mat li{ display:flex; gap:12px; align-items:baseline;}
    .mat li::before{ content:""; width:6px; height:6px; background:var(--accent-hi); border-radius:50%; flex:none; transform:translateY(-2px);}
    .regla{ margin-top:28px; padding:22px 26px; border:1px solid var(--line); display:grid; gap:8px; }
    .regla .tag{ font-family:var(--f-mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent-hi);}
    .regla p{ font-family:var(--f-serif); font-size:16px; line-height:1.55; color:var(--bone-2); margin:0;}
    .font{ margin-top:22px; font-family:var(--f-mono); font-size:11px; letter-spacing:.06em; line-height:1.7; color:var(--bone-3);}
    .font a{ color:var(--bone-3); border-bottom:1px solid var(--line-strong);}
    .font a:hover{ color:var(--accent-hi); border-color:var(--accent-hi);}

    .faq{ display:grid; gap:0; border-top:1px solid var(--line-ink); margin-top:60px;}
    .faq details{ border-bottom:1px solid var(--line-ink); padding:22px 0;}
    .faq summary{ list-style:none; cursor:pointer; display:flex; justify-content:space-between; align-items:center; gap:20px; font-family:var(--f-display); font-weight:500; font-size:clamp(19px,2vw,24px); letter-spacing:-0.02em; color:var(--bone-ink);}
    .faq summary::-webkit-details-marker{ display:none;}
    .faq summary::after{ content:"+"; font-family:var(--f-display); font-weight:400; font-size:24px; color:var(--accent-ink); transition:transform .3s;}
    .faq details[open] summary::after{ transform:rotate(45deg);}
    .faq p{ font-family:var(--f-serif); font-size:17px; line-height:1.55; color:var(--bone-ink); opacity:.75; margin:14px 0 0; max-width:60ch;}
  </style>

  <Nav currentPage="/opositors" />

  <section class="page-hero" id="main">
    <div class="bg" style="background-image:url('/assets/opositors-hero.webp')"></div>
    <div class="inner">
      <div class="crumb"><a href="/es">Inicio</a><span>/</span><span>Oposiciones</span></div>
      <div class="kicker"><span>Bomberos · Convocatoria 81/26</span><span class="bar"></span><span>Bomberos de Barcelona</span></div>
      <h1>Preparación física<br>para <em class="serif">oposiciones</em><span class="dot">.</span></h1>
      <p class="sub">Entrenamiento para opositores en Terrassa: tres clases dirigidas a la semana con los elementos de la prueba de Bomberos 2026, entrenamiento libre, simulacro mensual y sauna. Para Bombers de la Generalitat y Bomberos de Barcelona. <strong>{Q}/mes, sin matrícula.</strong></p>
      <div class="hero-acts">
        <a class="hero-cta" href={WA} target="_blank" rel="noopener" data-wa="hero">Escríbenos por WhatsApp<span class="arr"></span></a>
        <a class="btn-ghost" href="#opo-form">o déjanos tus datos</a>
      </div>
    </div>
  </section>

  <section class="sec ink">
    <div class="inner">
      <div class="eyebrow reveal"><span class="num">01 —</span><span>La cuota incluye</span></div>
      <div style="height:24px"></div>
      <div class="sec-head">
        <h2 class="h-xl reveal">Todo lo que incluye<br>la cuota de opositores<span class="dot">.</span></h2>
        <p class="lead reveal">Seis cosas, sin letra pequeña. Las dirigidas y las sesiones libres se reservan por la app Aimharder.</p>
      </div>

      <div class="incl-grid reveal-stagger">
        <div class="incl" style="--i:0">
          <span class="tag">01 · Programación</span>
          <h3>Programación <em>específica</em></h3>
          <p>Entrenamientos planificados y enfocados a las pruebas físicas de tu convocatoria.</p>
        </div>
        <div class="incl" style="--i:1">
          <span class="tag">02 · Dirigidas</span>
          <h3>3 clases <em>a la semana</em></h3>
          <p>Lunes, miércoles y viernes de 12:30 a 13:30: incendio de vegetación, incendio estructural y acondicionamiento físico general.</p>
        </div>
        <div class="incl" style="--i:2">
          <span class="tag">03 · Libre</span>
          <h3>3 sesiones <em>libres</em></h3>
          <p>Lunes, miércoles y viernes de 10:30 a 15:30; martes y jueves de 11:30 a 15:30. Todo el material del box y coaches en la sala.</p>
        </div>
        <div class="incl" style="--i:3">
          <span class="tag">04 · Grupo</span>
          <h3>WhatsApp <em>de opositores</em></h3>
          <p>Los entrenamientos específicos compartidos y el grupo en contacto durante todo el proceso.</p>
        </div>
        <div class="incl" style="--i:4">
          <span class="tag">05 · Simulacro</span>
          <h3>Circuito completo <em>cada mes</em></h3>
          <p>Cronometrado como el día de la prueba, encadenado y sin guantes, magnesio ni cinturón. Para ver la evolución.</p>
        </div>
        <div class="incl" style="--i:5">
          <span class="tag">06 · Sauna</span>
          <h3>1 sesión <em>al mes</em></h3>
          <p>15 minutos de sauna infrarroja para recuperar. Sauna ilimitada por {eur(PRICES.recoveryAddon, 'es')}/mes más.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec bone">
    <div class="inner">
      <div class="eyebrow reveal"><span class="num">02 —</span><span>Tarifa</span></div>
      <div style="height:24px"></div>
      <div class="sec-head">
        <h2 class="h-xl reveal">Una sola cuota,<br>todo incluido<span class="dot">.</span></h2>
        <p class="lead reveal">Si solo quieres venir un día o añadir sauna ilimitada, lo encontrarás en las preguntas frecuentes.</p>
      </div>

      <div class="tarifa reveal">
        <div class="price">
          <span class="tag">Cuota opositores</span>
          <h3>Cuota <em>mensual</em></h3>
          <div><span class="num">{PRICES.opositors}<sup>€</sup></span><span class="per">/mes · IVA incluido</span></div>
          <ul>
            <li>3 clases dirigidas + 3 sesiones libres a la semana</li>
            <li>Programación específica y grupo de WhatsApp</li>
            <li>Simulacro mensual del circuito y 1 sesión de sauna al mes</li>
          </ul>
        </div>
        <ul class="terms">
          <li><span><strong>Sin matrícula</strong> con la primera alta y sin permanencia.</span></li>
          <li><span><strong>Grupos de más de 4 personas:</strong> 10% de descuento el primer mes.</span></li>
          <li><span><strong>Acreditación:</strong> justificante o resguardo de inscripción a la convocatoria.</span></li>
          <li><span><strong>Reservas</strong> de dirigidas y sesiones libres por la app Aimharder.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="sec ink">
    <div class="inner">
      <div class="eyebrow reveal"><span class="num">03 —</span><span>La prueba</span></div>
      <div style="height:24px"></div>
      <div class="sec-head">
        <h2 class="h-xl reveal">La prueba física<br>de Bomberos 2026<span class="dot">.</span></h2>
        <p class="lead reveal">La convocatoria 81/26 tiene tres simulaciones de intervención cronometradas. Las dos de incendio se preparan en el box. La tercera, el rescate acuático, es en piscina.</p>
      </div>

      <div class="prova reveal">
        <figure class="pic">
          <img src="/assets/elbox-entrenament-1.webp" alt="Grupo entrenando con discos en la zona WOD de CrossFit La Mola, Terrassa" loading="lazy" width="900" height="600">
          <figcaption>Entrenamiento en el box · CrossFit La Mola, Terrassa</figcaption>
        </figure>
        <div>
          <div class="mat">
            <span class="tag">Material del circuito en el box</span>
            <ul>
              <li>Trineo y zona para arrastrarlo</li>
              <li>Arrastre de maniquí</li>
              <li>Wall balls</li>
              <li>Barra de equilibrio</li>
              <li>Cajones</li>
              <li>Espacio para la parte de carrera</li>
            </ul>
          </div>
          <div class="regla">
            <span class="tag">Bomberos de Barcelona</span>
            <p>La cuota también es para quien prepara Bomberos del Ayuntamiento de Barcelona (SPEIS). La base de fuerza y capacidad aeróbica es la misma.</p>
          </div>
          <p class="font">Fuente: <a href="https://portaldogc.gencat.cat/utilsEADOP/PDF/9751/2170230.pdf" target="_blank" rel="noopener">Resolución ISP/3218/2026 (DOGC núm. 9751, 15.9.2026)</a>. Las fechas de la prueba física aún no se han publicado. Las bases oficiales son la referencia.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec bone">
    <div class="inner">
      <div class="eyebrow reveal"><span class="num">04 —</span><span>Preguntas frecuentes</span></div>
      <div style="height:24px"></div>
      <h2 class="h-xl reveal">Dudas<br>habituales<span class="dot">.</span></h2>

      <div class="faq reveal" style="margin-top:52px;">
        <details><summary>¿Qué se puede preparar en el box de la prueba de Bomberos 2026?</summary><p>La convocatoria 81/26 tiene <strong>tres simulaciones cronometradas</strong>. Las dos de incendio (vegetación y estructural) se preparan en el box con el material del circuito. El <strong>rescate acuático</strong> se hace en piscina: desde el box solo aportamos base aeróbica, tracción y core.</p></details>
        <details><summary>¿Qué días hay clase dirigida?</summary><p><strong>Lunes, miércoles y viernes de 12:30 a 13:30.</strong> Cada semana: una sesión de incendio de vegetación, una de incendio estructural y una de acondicionamiento físico general. Se reservan por la app Aimharder.</p></details>
        <details><summary>¿Cuántos días puedo venir?</summary><p>Hasta seis: <strong>tres clases dirigidas y tres sesiones de entrenamiento libre</strong> a la semana. Las franjas libres son lunes, miércoles y viernes de 10:30 a 15:30, y martes y jueves de 11:30 a 15:30.</p></details>
        <details><summary>¿Hay matrícula o permanencia?</summary><p>No. Con la primera alta <strong>no cobramos matrícula</strong> y no hay permanencia. Si venís un grupo de más de cuatro personas, el primer mes tiene un <strong>10% de descuento</strong>.</p></details>
        <details><summary>¿Quién puede acceder a la cuota de opositores?</summary><p>Personas inscritas en una convocatoria de <strong>Bombers de la Generalitat</strong> o de <strong>Bomberos de Barcelona (SPEIS)</strong>. Hay que acreditar la inscripción para darse de alta.</p></details>
        <details><summary>¿Cuándo son las pruebas físicas?</summary><p>Las fechas <strong>aún no se han publicado</strong>. La física va después del test de conocimientos. Consulta siempre las bases oficiales de la convocatoria 81/26.</p></details>
        <details><summary>Quiero preparar las oposiciones y también hacer clases en el box. ¿Qué cuota necesito?</summary><p>La cuota de opositores da acceso a las tres dirigidas y a las tres sesiones libres semanales dentro de las franjas del mediodía. Para hacer también las clases del box (WOD, Hybrid Club, Weightlifting, Strength Club…) o entrenar en otros horarios, necesitas la <strong>cuota Ilimitada</strong>, que incluye el espacio y el material de opositores.</p></details>
        <details><summary>Ya tengo cuota en CrossFit La Mola. ¿Puedo usar el espacio de opositores?</summary><p>Sí. Con la <strong>cuota Ilimitada</strong> puedes acceder al espacio y al material de opositores dentro de la franja, sin ningún suplemento.</p></details>
        <details><summary>¿Puedo venir solo un día?</summary><p>Sí. El <strong>drop-in</strong> de opositores cuesta <strong>15€</strong> y da acceso un día a la franja libre y al material, sin cuota mensual. Con una sesión de sauna, 25€ en total. Escríbenos para reservar.</p></details>
        <details><summary>¿La sauna está incluida?</summary><p>Sí, <strong>una sesión de 15 minutos al mes</strong>. Si quieres sauna ilimitada, puedes añadir <a href="/es/recovery" style="color:inherit; text-decoration:underline; text-underline-offset:3px;">La Mola Recovery</a> a la cuota por <strong>9,90€ al mes</strong>.</p></details>
      </div>
    </div>
