---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import Schema from '../../components/Schema.astro'
import { PRICES, eur } from '../../data/pricing'

const WA = 'https://wa.me/34699196531?text=Hi!%20I%20am%20preparing%20for%20the%20Bombers%20de%20la%20Generalitat%20exam%20(call%2081%2F26)%20and%20would%20like%20information%20about%20the%20candidate%20membership%20at%20La%20Mola.'
const Q = eur(PRICES.opositors, 'en')
---

<Layout
  title="Firefighter Fitness Test Prep in Terrassa"
  description="Fitness test prep for civil service exams in Terrassa: 3 coached classes a week with the 2026 firefighter test elements, open training, a monthly mock test and sauna. €80/month."
  ogImage="/assets/og/og-opositors.jpg"
>
  <Schema type="base" slot="head" />
  <Breadcrumb items={[{name: "Exam prep"}]} lang="en" slot="head" />
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/opositors-hero.webp" fetchpriority="high" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Physical exam preparation · CrossFit La Mola",
      "serviceType": "Training for civil service physical tests",
      "provider": { "@id": "https://crossfitlamola.com/#organization" },
      "areaServed": {"@type": "City", "name": "Terrassa"},
      "audience": {"@type": "Audience", "audienceType": "Candidates for Bombers de la Generalitat de Catalunya (call 81/26), Barcelona city firefighters (SPEIS) exams"},
      "description": "Candidate membership in Terrassa: programming specific to the physical tests, three coached classes a week (Monday, Wednesday and Friday 12:30–13:30: wildland fire, structural fire and general conditioning), three open training sessions a week (Monday, Wednesday and Friday 10:30–15:30; Tuesday and Thursday 11:30–15:30), a WhatsApp group, a monthly timed mock test of the full circuit and one sauna session a month. Elements of the 2026 Bombers de la Generalitat physical test (Resolution ISP/3218/2026). The water rescue simulation is prepared in a pool. Bookings through the Aimharder app.",
      "offers": [
        {
          "@type": "Offer",
          "name": "Candidate membership",
          "description": "Specific programming, three coached classes and three open training sessions a week, WhatsApp group, monthly mock test and one sauna session a month. No joining fee on first sign-up. Groups of more than four people: 10% off the first month. Proof of exam registration required.",
          "priceCurrency": "EUR",
          "price": "80.00",
          "availability": "https://schema.org/InStock",
          "url": "https://crossfitlamola.com/en/opositors"
        },
        {
          "@type": "Offer",
          "name": "Unlimited sauna · add-on to the candidate membership",
          "description": "Unlimited access to the La Mola Recovery infrared sauna, added to the candidate membership.",
          "priceCurrency": "EUR",
          "price": "9.90",
          "availability": "https://schema.org/InStock",
          "url": "https://crossfitlamola.com/en/recovery"
        },
        {
          "@type": "Offer",
          "name": "Candidate day pass",
          "description": "One day of access to the candidate open training slot and the box equipment, no monthly membership.",
          "priceCurrency": "EUR",
          "price": "15.00",
          "availability": "https://schema.org/InStock",
          "url": "https://crossfitlamola.com/en/opositors"
        },
        {
          "@type": "Offer",
          "name": "Candidate day pass + sauna",
          "description": "One day of training in the candidate slot plus a sauna session for recovery (€10 supplement on the day pass).",
          "priceCurrency": "EUR",
          "price": "25.00",
          "availability": "https://schema.org/InStock",
          "url": "https://crossfitlamola.com/en/opositors"
        }
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {"@type": "Question", "name": "Which parts of the 2026 firefighter test can I prepare at the box?", "acceptedAnswer": {"@type": "Answer", "text": "Call 81/26 has three timed simulations. The two fire simulations (wildland and structural) are prepared at the box with the circuit equipment. The water rescue takes place in a pool: from the box we only contribute the aerobic base, pulling strength and core."}},
        {"@type": "Question", "name": "Which days are the coached classes?", "acceptedAnswer": {"@type": "Answer", "text": "Monday, Wednesday and Friday 12:30–13:30. Every week: one wildland fire session, one structural fire session and one general conditioning session. They are booked through the Aimharder app."}},
        {"@type": "Question", "name": "How many days can I come?", "acceptedAnswer": {"@type": "Answer", "text": "Up to six: three coached classes and three open training sessions a week. The open slots are Monday, Wednesday and Friday 10:30–15:30, and Tuesday and Thursday 11:30–15:30."}},
        {"@type": "Question", "name": "Is there a joining fee or a minimum term?", "acceptedAnswer": {"@type": "Answer", "text": "No. There is no joining fee on your first sign-up and no minimum term. If you come as a group of more than four people, the first month is 10% off."}},
        {"@type": "Question", "name": "Who can join?", "acceptedAnswer": {"@type": "Answer", "text": "People registered for a Bombers de la Generalitat or Barcelona firefighters (SPEIS) exam. Proof of registration is required to sign up."}},
        {"@type": "Question", "name": "When are the physical tests?", "acceptedAnswer": {"@type": "Answer", "text": "Dates have not been published yet. The physical test comes after the knowledge test. Always check the official announcement for call 81/26."}},
        {"@type": "Question", "name": "I want to prepare for the exam and also take classes. Which membership do I need?", "acceptedAnswer": {"@type": "Answer", "text": "The candidate membership gives access to the three coached classes and the three weekly open sessions within the midday slots. To also take the box classes (WOD, Hybrid Club, Weightlifting, Strength Club…) or train at other hours, you need the Unlimited membership, which includes the candidate space and equipment."}},
        {"@type": "Question", "name": "I'm already a member. Can I use the candidate space?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. With the Unlimited membership you can access the candidate space and equipment within the slot at no extra cost."}},
        {"@type": "Question", "name": "Can I come just one day?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. The candidate day pass costs €15 and gives one day of access to the open slot and the equipment, no monthly membership. With a sauna session, €25 in total. Message us to book."}},
        {"@type": "Question", "name": "Is the sauna included?", "acceptedAnswer": {"@type": "Answer", "text": "Yes, one 15-minute session a month. For unlimited sauna, add La Mola Recovery to your membership for €9.90 a month."}}
      ]
    }
    </script>
  </Fragment>

  <style>
    .hero-acts{ display:flex; flex-wrap:wrap; gap:16px 24px; align-items:center; margin-top:30px; }
    .hero-acts .hero-cta{ align-self:auto; }

    .incl-grid{ display:grid; gap:1px; margin-top:60px; background:var(--line); }
    @media(min-width:700px){ .incl-grid{ grid-template-columns:repeat(2,1fr);} }
    @media(min-width:1000px){ .incl-grid{ grid-template-columns:repeat(3,1fr);} }
    .incl{ background:var(--ink); padding:clamp(28px,3vw,40px); display:flex; flex-direction:column; gap:14px; }
    .incl .tag{ font-family:var(--f-mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent-hi);}
    .incl h3{ font-family:var(--f-display); font-weight:500; font-size:clamp(22px,2.4vw,30px); letter-spacing:-0.025em; line-height:1; margin:0; color:var(--bone);}
    .incl h3 em{ font-family:var(--f-serif); font-style:italic; font-weight:300; color:var(--accent-hi);}
    .incl p{ font-family:var(--f-serif); font-size:16px; line-height:1.55; color:var(--bone-2); margin:0;}

    /* 02 · Tarifa (fons bone): una sola targeta de preu + condicions */
    .tarifa{ display:grid; gap:40px; margin-top:60px; align-items:start; }
    @media(min-width:900px){ .tarifa{ grid-template-columns:minmax(0,460px) 1fr; gap:60px;} }
    .price{ background:var(--ink); padding:clamp(28px,3vw,40px); display:flex; flex-direction:column; gap:18px; color:var(--bone);}
    .price *{ color: inherit; }
    .price .tag{ font-family:var(--f-mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent-hi);}
    .price h3{ font-family:var(--f-display); font-weight:500; font-size:clamp(24px,2.6vw,32px); letter-spacing:-0.03em; line-height:.98; margin:0;}
    .price h3 em{ font-family:var(--f-serif); font-style:italic; font-weight:300; color:var(--accent-hi);}
    .price .num{ font-family:var(--f-display); font-weight:500; font-size:clamp(48px,6vw,72px); letter-spacing:-0.04em; line-height:1;}
    .price .num sup{ font-size:.4em; font-weight:500; vertical-align:.5em; margin-left:4px;}
    .price .per{ font-family:var(--f-mono); font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:var(--muted); margin-left:8px;}
    .price ul{ list-style:none; padding:0; margin:0; font-family:var(--f-serif); font-size:16.5px; line-height:1.55; display:grid; gap:10px;}
    .price ul li{ display:flex; gap:12px; align-items:baseline;}
    .price ul li::before{ content:""; width:6px; height:6px; background:var(--accent-hi); border-radius:50%; flex:none; transform:translateY(2px);}
    .terms{ list-style:none; margin:0; padding:0; display:grid; gap:0; border-top:1px solid var(--line-ink);}
    .terms li{ display:flex; gap:14px; align-items:baseline; padding:18px 0; border-bottom:1px solid var(--line-ink); font-family:var(--f-serif); font-size:17px; line-height:1.5; color:var(--bone-ink);}
    .terms li::before{ content:""; width:6px; height:6px; background:var(--accent-ink); border-radius:50%; flex:none; transform:translateY(-2px);}
    .terms strong{ font-weight:500;}

    /* 03 · La prova (fons ink, foto + material) */
    .prova{ display:grid; gap:40px; margin-top:60px; align-items:start; }
    @media(min-width:900px){ .prova{ grid-template-columns:1fr 1fr; gap:60px;} }
    .prova .pic{ margin:0; aspect-ratio:4/3; overflow:hidden; border:1px solid var(--line); background:#1a1712; }
    .prova .pic img{ width:100%; height:100%; object-fit:cover; display:block; }
    .prova .pic figcaption{ font-family:var(--f-mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--bone-3); padding:10px 0 0; }
    .mat{ border-top:1px solid var(--line); display:grid; gap:18px; padding-top:22px; }
    .mat .tag{ font-family:var(--f-mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent-hi);}
    .mat ul{ list-style:none; margin:0; padding:0; display:grid; gap:10px; font-family:var(--f-serif); font-size:16.5px; line-height:1.5; color:var(--bone-2);}
    @media(min-width:560px){ .mat ul{ grid-template-columns:1fr 1fr; gap:10px 28px;} }
    .mat li{ display:flex; gap:12px; align-items:baseline;}
    .mat li::before{ content:""; width:6px; height:6px; background:var(--accent-hi); border-radius:50%; flex:none; transform:translateY(-2px);}
    .regla{ margin-top:28px; padding:22px 26px; border:1px solid var(--line); display:grid; gap:8px; }
    .regla .tag{ font-family:var(--f-mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent-hi);}
    .regla p{ font-family:var(--f-serif); font-size:16px; line-height:1.55; color:var(--bone-2); margin:0;}
    .font{ margin-top:22px; font-family:var(--f-mono); font-size:11px; letter-spacing:.06em; line-height:1.7; color:var(--bone-3);}
    .font a{ color:var(--bone-3); border-bottom:1px solid var(--line-strong);}
    .font a:hover{ color:var(--accent-hi); border-color:var(--accent-hi);}

    .faq{ display:grid; gap:0; border-top:1px solid var(--line-ink); margin-top:60px;}
    .faq details{ border-bottom:1px solid var(--line-ink); padding:22px 0;}
    .faq summary{ list-style:none; cursor:pointer; display:flex; justify-content:space-between; align-items:center; gap:20px; font-family:var(--f-display); font-weight:500; font-size:clamp(19px,2vw,24px); letter-spacing:-0.02em; color:var(--bone-ink);}
    .faq summary::-webkit-details-marker{ display:none;}
    .faq summary::after{ content:"+"; font-family:var(--f-display); font-weight:400; font-size:24px; color:var(--accent-ink); transition:transform .3s;}
    .faq details[open] summary::after{ transform:rotate(45deg);}
    .faq p{ font-family:var(--f-serif); font-size:17px; line-height:1.55; color:var(--bone-ink); opacity:.75; margin:14px 0 0; max-width:60ch;}
  </style>

  <Nav currentPage="/opositors" />

  <section class="page-hero" id="main">
    <div class="bg" style="background-image:url('/assets/opositors-hero.webp')"></div>
    <div class="inner">
      <div class="crumb"><a href="/en">Home</a><span>/</span><span>Exam prep</span></div>
      <div class="kicker"><span>Firefighters · Call 81/26</span><span class="bar"></span><span>Barcelona firefighters</span></div>
      <h1>Physical prep<br>for <em class="serif">civil service exams</em><span class="dot">.</span></h1>
      <p class="sub">Training for exam candidates in Terrassa: three coached classes a week with the elements of the 2026 firefighter test, open training, a monthly mock test and sauna. For Bombers de la Generalitat and Barcelona firefighter candidates. <strong>{Q}/month, no joining fee.</strong></p>
      <div class="hero-acts">
        <a class="hero-cta" href={WA} target="_blank" rel="noopener" data-wa="hero">Message us on WhatsApp<span class="arr"></span></a>
        <a class="btn-ghost" href="#opo-form">or leave your details</a>
      </div>
    </div>
  </section>

  <section class="sec ink">
    <div class="inner">
      <div class="eyebrow reveal"><span class="num">01 —</span><span>What's included</span></div>
      <div style="height:24px"></div>
      <div class="sec-head">
        <h2 class="h-xl reveal">Everything the candidate<br>membership includes<span class="dot">.</span></h2>
        <p class="lead reveal">Six things, no small print. Coached classes and open sessions are booked through the Aimharder app.</p>
      </div>

      <div class="incl-grid reveal-stagger">
        <div class="incl" style="--i:0">
          <span class="tag">01 · Programming</span>
          <h3>Specific <em>programming</em></h3>
          <p>Training planned around the physical tests of your exam call.</p>
        </div>
        <div class="incl" style="--i:1">
          <span class="tag">02 · Coached</span>
          <h3>3 classes <em>a week</em></h3>
          <p>Monday, Wednesday and Friday 12:30–13:30: wildland fire, structural fire and general conditioning.</p>
        </div>
        <div class="incl" style="--i:2">
          <span class="tag">03 · Open</span>
          <h3>3 open <em>sessions</em></h3>
          <p>Monday, Wednesday and Friday 10:30–15:30; Tuesday and Thursday 11:30–15:30. All the box equipment and coaches on the floor.</p>
        </div>
        <div class="incl" style="--i:3">
          <span class="tag">04 · Group</span>
          <h3>Candidates' <em>WhatsApp</em></h3>
          <p>The specific sessions shared and the group in touch throughout the process.</p>
        </div>
        <div class="incl" style="--i:4">
          <span class="tag">05 · Mock test</span>
          <h3>Full circuit <em>every month</em></h3>
          <p>Timed the way it is done on test day, chained together with no gloves, chalk or belt. To track progress.</p>
        </div>
        <div class="incl" style="--i:5">
          <span class="tag">06 · Sauna</span>
          <h3>1 session <em>a month</em></h3>
          <p>15 minutes of infrared sauna to recover. Unlimited sauna for {eur(PRICES.recoveryAddon, 'en')}/month extra.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec bone">
    <div class="inner">
      <div class="eyebrow reveal"><span class="num">02 —</span><span>Pricing</span></div>
      <div style="height:24px"></div>
      <div class="sec-head">
        <h2 class="h-xl reveal">One membership,<br>everything included<span class="dot">.</span></h2>
        <p class="lead reveal">Day passes and unlimited sauna are covered in the FAQ.</p>
      </div>

      <div class="tarifa reveal">
        <div class="price">
          <span class="tag">Candidate membership</span>
          <h3>Monthly <em>membership</em></h3>
          <div><span class="num">{PRICES.opositors}<sup>€</sup></span><span class="per">/month · VAT incl.</span></div>
          <ul>
            <li>3 coached classes + 3 open sessions a week</li>
            <li>Specific programming and WhatsApp group</li>
            <li>Monthly circuit mock test and 1 sauna session a month</li>
          </ul>
        </div>
        <ul class="terms">
          <li><span><strong>No joining fee</strong> on first sign-up and no minimum term.</span></li>
          <li><span><strong>Groups of more than 4 people:</strong> 10% off the first month.</span></li>
          <li><span><strong>Proof of registration</strong> for the exam call is required to sign up.</span></li>
          <li><span><strong>Bookings</strong> for coached classes and open sessions through the Aimharder app.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="sec ink">
    <div class="inner">
      <div class="eyebrow reveal"><span class="num">03 —</span><span>The test</span></div>
      <div style="height:24px"></div>
      <div class="sec-head">
        <h2 class="h-xl reveal">The 2026 firefighter<br>physical test<span class="dot">.</span></h2>
        <p class="lead reveal">Call 81/26 has three timed intervention simulations. The two fire simulations are prepared at the box. The third, the water rescue, is in a pool.</p>
      </div>

      <div class="prova reveal">
        <figure class="pic">
          <img src="/assets/elbox-entrenament-1.webp" alt="Group training with plates in the WOD area at CrossFit La Mola, Terrassa" loading="lazy" width="900" height="600">
          <figcaption>Training at the box · CrossFit La Mola, Terrassa</figcaption>
        </figure>
        <div>
          <div class="mat">
            <span class="tag">Circuit equipment at the box</span>
            <ul>
              <li>Sled and a lane to drag it</li>
              <li>Dummy drag</li>
              <li>Wall balls</li>
              <li>Balance beam</li>
              <li>Boxes</li>
              <li>Space for the running work</li>
            </ul>
          </div>
          <div class="regla">
            <span class="tag">Barcelona firefighters</span>
            <p>The membership is also for candidates preparing for Barcelona city firefighters (SPEIS). The strength and aerobic base is the same.</p>
          </div>
          <p class="font">Source: <a href="https://portaldogc.gencat.cat/utilsEADOP/PDF/9751/2170230.pdf" target="_blank" rel="noopener">Resolution ISP/3218/2026 (DOGC no. 9751, 15.9.2026)</a>. Physical test dates have not been published yet. The official announcement is the reference.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec bone">
    <div class="inner">
      <div class="eyebrow reveal"><span class="num">04 —</span><span>FAQ</span></div>
      <div style="height:24px"></div>
      <h2 class="h-xl reveal">Common<br>questions<span class="dot">.</span></h2>

      <div class="faq reveal" style="margin-top:52px;">
        <details><summary>Which parts of the 2026 firefighter test can I prepare at the box?</summary><p>Call 81/26 has <strong>three timed simulations</strong>. The two fire simulations (wildland and structural) are prepared at the box with the circuit equipment. The <strong>water rescue</strong> takes place in a pool: from the box we only contribute the aerobic base, pulling strength and core.</p></details>
        <details><summary>Which days are the coached classes?</summary><p><strong>Monday, Wednesday and Friday 12:30–13:30.</strong> Every week: one wildland fire session, one structural fire session and one general conditioning session. They are booked through the Aimharder app.</p></details>
        <details><summary>How many days can I come?</summary><p>Up to six: <strong>three coached classes and three open training sessions</strong> a week. The open slots are Monday, Wednesday and Friday 10:30–15:30, and Tuesday and Thursday 11:30–15:30.</p></details>
        <details><summary>Is there a joining fee or a minimum term?</summary><p>No. There is <strong>no joining fee</strong> on your first sign-up and no minimum term. If you come as a group of more than four people, the first month is <strong>10% off</strong>.</p></details>
        <details><summary>Who can join?</summary><p>People registered for a <strong>Bombers de la Generalitat</strong> or <strong>Barcelona firefighters (SPEIS)</strong> exam. Proof of registration is required to sign up.</p></details>
        <details><summary>When are the physical tests?</summary><p>Dates <strong>have not been published yet</strong>. The physical test comes after the knowledge test. Always check the official announcement for call 81/26.</p></details>
        <details><summary>I want to prepare for the exam and also take classes. Which membership do I need?</summary><p>The candidate membership gives access to the three coached classes and the three weekly open sessions within the midday slots. To also take the box classes (WOD, Hybrid Club, Weightlifting, Strength Club…) or train at other hours, you need the <strong>Unlimited membership</strong>, which includes the candidate space and equipment.</p></details>
        <details><summary>I'm already a member. Can I use the candidate space?</summary><p>Yes. With the <strong>Unlimited membership</strong> you can access the candidate space and equipment within the slot at no extra cost.</p></details>
        <details><summary>Can I come just one day?</summary><p>Yes. The candidate <strong>day pass</strong> costs <strong>€15</strong> and gives one day of access to the open slot and the equipment, no monthly membership. With a sauna session, €25 in total. Message us to book.</p></details>
        <details><summary>Is the sauna included?</summary><p>Yes, <strong>one 15-minute session a month</strong>. For unlimited sauna, add <a href="/en/recovery" style="color:inherit; text-decoration:underline; text-underline-offset:3px;">La Mola Recovery</a> to your membership for <strong>€9.90 a month</strong>.</p></details>
      </div>
    </div>
  </section>

  <section class="cta-block">
    <div class="bg" style="background-image:url('/assets/hero-climb.jpg')"></div>
    <div class="inner">
      <div class="eyebrow reveal" style="color:var(--bone-3)"><span class="num" style="color:var(--accent-hi)">05 —</span><span>Let's start</span></div>
      <h2 class="h-hero reveal">Your spot is<br>earned <em class="serif">today</em><span class="dot">.</span></h2>
      <p class="reveal">Tell us which exam you are preparing for and we'll get back to you with the information and the next steps.</p>
      <form id="opo-form" class="reveal" style="display:grid; gap:24px; max-width:560px;">
        <input type="text" name="website" style="position:absolute;left:-9999px;" tabindex="-1" autocomplete="off" aria-hidden="true" aria-label="Honeypot anti-spam">
        <div class="form-row two">
          <div class="field"><label for="o-name">Name</label><input id="o-name" type="text" name="name" required aria-required="true" placeholder="What's your name?"></div>
          <div class="field"><label for="o-phone">Phone</label><input id="o-phone" type="tel" name="phone" required aria-required="true" placeholder="629 ..."></div>
        </div>
        <div class="field"><label for="o-prep">Which exam are you preparing for?</label>
          <select id="o-prep" name="prep">
            <option>Bombers de la Generalitat (call 81/26)</option><option>Barcelona Firefighters (SPEIS)</option>
          </select>
        </div>
        <div class="field"><label for="o-note">Any comments? (optional)</label><input id="o-note" type="text" name="note" placeholder="Exam call, test dates, questions..."></div>
        <div class="actions" style="margin-top:0;">
          <button type="submit" class="form-submit" id="opo-submit">Get info<span style="display:inline-block; width:20px; height:1px; background:currentColor;"></span></button>
          <a class="btn-ghost" href={WA} target="_blank" rel="noopener" data-wa="form">or via WhatsApp</a>
        </div>
