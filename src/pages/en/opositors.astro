---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import Schema from '../../components/Schema.astro'

const WA = 'https://wa.me/34699196531?text=Hi!%20I%20am%20preparing%20for%20the%20Bombers%20de%20la%20Generalitat%20exam%20(call%2081%2F26)%20and%20would%20like%20information%20about%20the%20candidate%20membership%20at%20La%20Mola.'
---

<Layout
  title="Firefighter & Mossos Fitness Test Prep in Terrassa"
  description="Weekly coached class with the 2026 firefighter test elements plus one hour of open training a day. Mon–Fri 11:30–15:30 and Sundays. €65/month, first class free."
  ogImage="/assets/opositors-hero.webp"
>
  <Schema type="base" slot="head" />
  <Breadcrumb items={[{name: "Exam prep"}]} lang="en" slot="head" />
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/opositors-hero.webp" fetchpriority="high" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Physical exam preparation · CrossFit La Mola",
      "serviceType": "Training for civil service physical tests",
      "provider": { "@id": "https://crossfitlamola.com/#organization" },
      "areaServed": {"@type": "City", "name": "Terrassa"},
      "audience": {"@type": "Audience", "audienceType": "Candidates for Bombers de la Generalitat de Catalunya (call 81/26), Barcelona city firefighters (SPEIS) and Mossos d'Esquadra exams"},
      "description": "Training slot for exam candidates, Monday to Friday 11:30–15:30 and Sundays 9:30–11:30. A coached class for exam candidates every Thursday 14:30–15:30, with the elements of the 2026 Bombers de la Generalitat physical test (Resolution ISP/3218/2026), and one hour of open training a day with coaches on the floor. Personalised programming on request. The water rescue simulation is prepared in a pool.",
      "offers": [
        {
          "@type": "Offer",
          "name": "Candidate membership",
          "description": "Weekly coached class (Thursday 14:30–15:30) and one hour of open training a day within the slot: Monday to Friday 11:30–15:30 and Sundays 9:30–11:30. Proof of exam registration required.",
          "priceCurrency": "EUR",
          "price": "65.00",
          "availability": "https://schema.org/InStock",
          "url": "https://crossfitlamola.com/en/opositors"
        },
        {
          "@type": "Offer",
          "name": "First candidate coached class · free",
          "description": "The first coached class for exam candidates (Thursday 14:30–15:30) is free, to get to know the box and try the equipment.",
          "priceCurrency": "EUR",
          "price": "0.00",
          "availability": "https://schema.org/InStock",
          "url": "https://crossfitlamola.com/en/opositors"
        },
        {
          "@type": "Offer",
          "name": "Candidate day pass",
          "description": "One day of access to the candidate slot and the box equipment, no monthly membership.",
          "priceCurrency": "EUR",
          "price": "15.00",
          "availability": "https://schema.org/InStock",
          "url": "https://crossfitlamola.com/en/opositors"
        },
        {
          "@type": "Offer",
          "name": "Candidate day pass + sauna",
          "description": "One day of training in the candidate slot plus a sauna session for recovery (€10 supplement on the day pass).",
          "priceCurrency": "EUR",
          "price": "25.00",
          "availability": "https://schema.org/InStock",
          "url": "https://crossfitlamola.com/en/opositors"
        }
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {"@type": "Question", "name": "Which parts of the 2026 firefighter test can I prepare at the box?", "acceptedAnswer": {"@type": "Answer", "text": "Call 81/26 has three timed simulations. The two fire simulations (wildland and structural) are prepared at the box: the equipment is on the floor and we work on it in the coached class and during open hours, with timed mock tests from time to time. The water rescue takes place in a pool and cannot be prepared here: from the box we only contribute the aerobic base, pulling strength and core."}},
        {"@type": "Question", "name": "Is there coached training or programming?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Every Thursday 14:30–15:30 there is a coached class for exam candidates: high-intensity training with the elements of the test plus strength work. The rest of the slot is one hour a day of open training with coaches on the floor. If you want personalised programming for your exam, ask us."}},
        {"@type": "Question", "name": "When are the physical tests?", "acceptedAnswer": {"@type": "Answer", "text": "Dates have not been published yet. The physical test comes after the knowledge test. Registration for call 81/26 is at tràmits.gencat.cat for 10 working days from 16 September. Always check the official announcement."}},
        {"@type": "Question", "name": "Who can join?", "acceptedAnswer": {"@type": "Answer", "text": "Anyone registered for an exam with physical tests: Bombers de la Generalitat, Barcelona firefighters (SPEIS), Mossos d'Esquadra or other forces. Proof of registration is required to sign up."}},
        {"@type": "Question", "name": "Can I come every day?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Each day of the slot you get one hour of open training, at the time you choose: Monday to Friday between 11:30 and 15:30, plus Sundays between 9:30 and 11:30. On Thursdays, the coached class is that hour."}},
        {"@type": "Question", "name": "Can I try it before signing up?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. The first coached class for exam candidates is free: come on a Thursday at 14:30, get to know the box and try the equipment we work with. For any other day there is the €15 day pass."}},
        {"@type": "Question", "name": "I want to prepare for the exam and also take classes. Which membership do I need?", "acceptedAnswer": {"@type": "Answer", "text": "The candidate membership (€65/month) gives access to the Thursday coached class and one hour a day within the weekday 11:30–15:30 slot and Sunday mornings. If you also want to take any of the box classes (WOD, Hybrid Club, Weightlifting, Strength Club…) or train at other hours, you need the Unlimited membership, which also includes the candidate space and equipment."}},
        {"@type": "Question", "name": "I'm already a member. Can I use the candidate space?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. With the Unlimited membership you can access the candidate space and equipment within the slot at no extra cost."}},
        {"@type": "Question", "name": "Can I come just one day to test myself?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. The candidate day pass costs €15 and includes one day of access to the slot and the equipment, no monthly membership. If you also want to recover well and get the benefits of the sauna, add €10 for a full day of training and recovery: €25 in total."}}
      ]
    }
    </script>
  </Fragment>

  <style>
    .hero-acts{ display:flex; flex-wrap:wrap; gap:16px 24px; align-items:center; margin-top:30px; }
    .hero-acts .hero-cta{ align-self:auto; }

    .cossos{ display:grid; gap:1px; margin-top:60px; background:var(--line); }
    @media(min-width:900px){ .cossos{ grid-template-columns:repeat(3,1fr);} }
    .cos{ background:var(--ink); padding:clamp(28px,3vw,40px); display:flex; flex-direction:column; gap:14px; }
    .cos .tag{ font-family:var(--f-mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent-hi);}
    .cos h3{ font-family:var(--f-display); font-weight:500; font-size:clamp(22px,2.2vw,28px); letter-spacing:-0.025em; line-height:1.02; margin:0; color:var(--bone);}
    .cos h3 em{ font-family:var(--f-serif); font-style:italic; font-weight:300; color:var(--accent-hi);}
    .cos p{ font-family:var(--f-serif); font-size:16px; line-height:1.55; color:var(--bone-2); margin:0;}

    .regla{ margin-top:48px; padding:26px 30px; border:1px solid var(--line); display:grid; gap:10px; }
    .regla .tag{ font-family:var(--f-mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent-hi);}
    .regla p{ font-family:var(--f-serif); font-size:16px; line-height:1.55; color:var(--bone-2); margin:0; max-width:75ch;}
    .mat{ margin-top:48px; padding:26px 30px; border:1px solid var(--line); display:grid; gap:20px; }
    .mat .tag{ font-family:var(--f-mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent-hi);}
    .mat-cols{ display:grid; gap:22px 40px; grid-template-columns:1fr; }
    @media(min-width:760px){ .mat-cols{ grid-template-columns:1fr 1fr;} }
    .mat h4{ font-family:var(--f-display); font-weight:500; font-size:clamp(18px,1.8vw,22px); letter-spacing:-0.02em; line-height:1.1; margin:0 0 12px; color:var(--bone);}
    .mat ul{ margin:0; padding-left:18px; font-family:var(--f-serif); font-size:16px; line-height:1.6; color:var(--bone-2);}
    .mat li + li{ margin-top:4px;}
    .font{ margin-top:22px; font-family:var(--f-mono); font-size:11px; letter-spacing:.06em; line-height:1.7; color:var(--bone-3);}
    .font a{ color:var(--bone-3); border-bottom:1px solid var(--line-strong);}
    .font a:hover{ color:var(--accent-hi); border-color:var(--accent-hi);}

    .conds{ display:grid; gap:0; margin-top:60px; border-top:1px solid var(--line-ink);}
    .conds > div{ display:grid; grid-template-columns:1fr; gap:8px 24px; padding:24px 0; border-bottom:1px solid var(--line-ink); align-items:baseline;}
    @media(min-width:760px){ .conds > div{ grid-template-columns:200px 1fr auto;} }
    @media(max-width:759px){ .conds .p{ display:none;} }
    .conds .label{ font-family:var(--f-mono); font-size:11px; letter-spacing:.2em; text-transform:uppercase; color:var(--accent-ink);}
    .conds h4{ font-family:var(--f-display); font-weight:500; font-size:clamp(20px,2vw,26px); letter-spacing:-0.02em; margin:0; color:var(--bone-ink);}
    .conds p{ font-family:var(--f-serif); font-size:16px; line-height:1.55; color:var(--bone-ink); opacity:.75; margin:6px 0 0; max-width:65ch;}
    .conds .p{ font-family:var(--f-display); font-weight:500; font-size:clamp(22px,2.4vw,30px); letter-spacing:-0.02em; color:var(--bone-ink);}

    .faq{ display:grid; gap:0; border-top:1px solid var(--line); margin-top:60px;}
    .faq details{ border-bottom:1px solid var(--line); padding:22px 0;}
    .faq summary{ list-style:none; cursor:pointer; display:flex; justify-content:space-between; align-items:center; gap:20px; font-family:var(--f-display); font-weight:500; font-size:clamp(19px,2vw,24px); letter-spacing:-0.02em; color:var(--bone);}
    .faq summary::-webkit-details-marker{ display:none;}
    .faq summary::after{ content:"+"; font-family:var(--f-display); font-weight:400; font-size:24px; color:var(--accent-hi); transition:transform .3s;}
    .faq details[open] summary::after{ transform:rotate(45deg);}
    .faq p{ font-family:var(--f-serif); font-size:17px; line-height:1.55; color:var(--bone-2); margin:14px 0 0; max-width:60ch;}
  </style>

  <Nav currentPage="/en/opositors" />

  <section class="page-hero">
    <div class="bg" style="background-image:url('/assets/opositors-hero.webp')"></div>
    <div class="inner">
      <div class="crumb"><a href="/en">Home</a><span>/</span><span>Exam prep</span></div>
      <div class="kicker"><span>Firefighters · Call 81/26 open</span><span class="bar"></span><span>Mossos d'Esquadra</span></div>
      <h1>Physical prep<br>for <em class="serif">civil service exams</em><span class="dot">.</span></h1>
      <p class="sub">A slot <strong>for exam candidates</strong> in Terrassa: a weekly coached class with the elements of the 2026 firefighter test and one hour of open training a day, with coaches on the floor. Also for Barcelona firefighter and Mossos d'Esquadra candidates. Monday to Friday between 11:30 and 15:30, and Sundays between 9:30 and 11:30. €65/month. First class free. <strong>Free open day: Sunday 11 October, 9:30–11:30. Limited places.</strong></p>
      <div class="hero-acts">
        <a class="hero-cta" href={WA} target="_blank" rel="noopener" data-wa="hero">Message us on WhatsApp<span class="arr"></span></a>
        <a class="btn-ghost" href="#opo-form">or leave your details</a>
      </div>
    </div>
  </section>

  <section class="sec ink">
    <div class="inner">
      <div class="eyebrow reveal"><span class="num">01 —</span><span>What we train</span></div>
      <div style="height:24px"></div>
      <div class="sec-head">
        <h2 class="h-xl reveal">Coached class<br>and open training<span class="dot">.</span></h2>
        <p class="lead reveal">The 2026 Bombers de la Generalitat physical test (call 81/26) has three timed intervention simulations. The two fire simulations are prepared at the box. The third, the water rescue, is in a pool.</p>
      </div>

      <div class="cossos reveal-stagger">
        <div class="cos" style="--i:0">
          <span class="tag">01 · Coached</span>
          <h3>Thursdays, <em>14:30</em></h3>
          <p>One weekly class for exam candidates: high-intensity training with the elements of the test plus specific strength work. Build strength and endurance, and master the elements under fatigue.</p>
        </div>
        <div class="cos" style="--i:1">
          <span class="tag">02 · Slot</span>
          <h3>One hour <em>a day</em></h3>
          <p>Each day of the slot you get one hour of open training with all the box equipment. There is always a coach on the floor: if you have questions during your session, we guide you.</p>
        </div>
        <div class="cos" style="--i:2">
          <span class="tag">03 · Circuit</span>
          <h3>And <em>mock tests</em></h3>
          <p>The circuit equipment is at the box. We work on it in the coached class and during open hours, and from time to time we run timed mock tests the way it is done on test day: chained together, no gloves, chalk or belt.</p>
        </div>
      </div>


      <div class="mat reveal">
        <span class="tag">Circuit equipment available at the box</span>
        <div class="mat-cols">
          <div>
            <ul>
              <li>Sled and a lane to drag it</li>
              <li>Wall balls</li>
              <li>Boxes</li>
            </ul>
          </div>
          <div>
            <ul>
              <li>Dummy drag (70 kg worm)</li>
              <li>Balance beam</li>
              <li>Enough space for the running work</li>
            </ul>
          </div>
        </div>
      </div>
      <p class="font reveal">Source: <a href="https://portaldogc.gencat.cat/utilsEADOP/PDF/9751/2170230.pdf" target="_blank" rel="noopener">Resolution ISP/3218/2026 (DOGC no. 9751, 15.9.2026)</a>. Registration at tràmits.gencat.cat for 10 working days from 16 September. Physical test dates have not been published yet. The official announcement is the reference.</p>

      <div class="regla reveal">
        <span class="tag">Barcelona firefighters · Mossos d'Esquadra · other forces</span>
        <p>The slot is also for candidates preparing for Barcelona city firefighters (SPEIS), Mossos d'Esquadra or any other exam with physical tests. The equipment and the strength and aerobic base are the same. Check your call's official announcement and, if you are unsure what to work on, ask us.</p>
      </div>

    </div>
  </section>

  <section class="sec bone">
    <div class="inner">
      <div class="eyebrow reveal"><span class="num">02 —</span><span>Conditions</span></div>
      <div style="height:24px"></div>
      <h2 class="h-xl reveal">Monthly membership<br>or a one-day pass<span class="dot">.</span></h2>

      <div class="conds reveal">
        <div><span class="label">01 · Price</span><div><h4>€65/month · VAT included</h4><p>A weekly coached class and one hour of open training a day within the candidate slot.</p></div><span class="p">€65<span style="font-family:var(--f-mono); font-size:11px; color:var(--muted-ink); margin-left:6px;">/month</span></span></div>
        <div><span class="label">02 · Slot</span><div><h4>Monday to Friday · 11:30–15:30</h4><p>One hour a day, at the time you choose, with all the box equipment available. Plus <strong>Sundays from 9:30 to 11:30</strong>.</p></div><span class="p">6<span style="font-family:var(--f-mono); font-size:11px; color:var(--muted-ink); margin-left:6px;">days/wk</span></span></div>
        <div><span class="label">03 · Coached</span><div><h4>Thursday · 14:30–15:30</h4><p>A class for exam candidates with the elements of the test. On Thursdays, the class is your hour for the day.</p></div><span class="p">1<span style="font-family:var(--f-mono); font-size:11px; color:var(--muted-ink); margin-left:6px;">class/wk</span></span></div>
        <div><span class="label">04 · Programming</span><div><h4>Personalised · ask us</h4><p>If you want programming tailored to your exam and your starting point, ask us.</p></div></div>
        <div><span class="label">05 · Proof</span><div><h4>Exam registration required</h4><p>To access this rate you must show proof of registration for the current exam call.</p></div></div>
        <div><span class="label">06 · First class</span><div><h4>Coached · free</h4><p>Come on a Thursday at 14:30, get to know the box and try the equipment we work with.</p></div><span class="p">€0<span style="font-family:var(--f-mono); font-size:11px; color:var(--muted-ink); margin-left:6px;">1st class</span></span></div>
        <div><span class="label">07 · Day pass</span><div><h4>One day · €15</h4><p>One day of access to the slot and the equipment, no monthly membership.</p></div><span class="p">€15<span style="font-family:var(--f-mono); font-size:11px; color:var(--muted-ink); margin-left:6px;">/day</span></span></div>
        <div><span class="label">08 · Sauna</span><div><h4>Recovery · +€10</h4><p>Add a sauna session to your day pass for a full day of training and recovery: €25 in total. <a href="/en/recovery" style="color:var(--accent-ink); text-decoration:underline; text-underline-offset:3px;">La Mola Recovery →</a></p></div><span class="p">+€10<span style="font-family:var(--f-mono); font-size:11px; color:var(--muted-ink); margin-left:6px;">/session</span></span></div>
      </div>
    </div>
  </section>

  <section class="sec ink">
    <div class="inner">
      <div class="eyebrow reveal"><span class="num">03 —</span><span>FAQ</span></div>
      <div style="height:24px"></div>
      <h2 class="h-xl reveal" style="color:var(--bone)">Common<br>questions<span class="dot">.</span></h2>

      <div class="faq reveal" style="margin-top:52px;">
        <details><summary>Which parts of the 2026 firefighter test can I prepare at the box?</summary><p>Call 81/26 has <strong>three timed simulations</strong>. The two <strong>fire simulations</strong> (wildland and structural) are prepared at the box: the equipment is on the floor and we work on it in the coached class and during open hours, with timed mock tests from time to time. The <strong>water rescue</strong> takes place in a pool and cannot be prepared here: from the box we only contribute the aerobic base, pulling strength and core.</p></details>
        <details><summary>Is there coached training or programming?</summary><p>Yes. Every <strong>Thursday 14:30–15:30</strong> there is a coached class for exam candidates: high-intensity training with the elements of the test plus strength work. The rest of the slot is <strong>one hour a day</strong> of open training with coaches on the floor. If you want <strong>personalised programming</strong> for your exam, ask us.</p></details>
        <details><summary>When are the physical tests?</summary><p>Dates <strong>have not been published yet</strong>. The physical test comes after the knowledge test. Registration for call 81/26 is at tràmits.gencat.cat for 10 working days from 16 September. Always check the official announcement.</p></details>
        <details><summary>Who can join?</summary><p>Anyone registered for an exam with physical tests: <strong>Bombers de la Generalitat</strong>, <strong>Barcelona firefighters (SPEIS)</strong>, <strong>Mossos d'Esquadra</strong> or other forces. Proof of registration is required to sign up.</p></details>
        <details><summary>Can I come every day?</summary><p>Yes. Each day of the slot you get <strong>one hour</strong> of open training, at the time you choose: Monday to Friday between 11:30 and 15:30, plus Sundays between 9:30 and 11:30. On Thursdays, the coached class is that hour.</p></details>
        <details><summary>Can I try it before signing up?</summary><p>Yes. The <strong>first coached class</strong> for exam candidates is free: come on a Thursday at 14:30, get to know the box and try the equipment we work with. For any other day there is the €15 day pass.</p></details>
        <details><summary>I want to prepare for the exam and also take classes. Which membership do I need?</summary><p>The candidate membership (€65/month) gives access to the Thursday coached class and one hour a day within the weekday 11:30–15:30 slot and Sunday mornings. If you also want to take any of the box classes (WOD, Hybrid Club, Weightlifting, Strength Club…) or train at other hours, you need the <strong>Unlimited membership</strong>, which also includes the candidate space and equipment.</p></details>
        <details><summary>I'm already a member. Can I use the candidate space?</summary><p>Yes. With the <strong>Unlimited membership</strong> you can access the candidate space and equipment within the slot at no extra cost.</p></details>
        <details><summary>Can I come just one day to test myself?</summary><p>Yes. The candidate <strong>day pass</strong> costs <strong>€15</strong> and includes one day of access to the slot and the equipment, no monthly membership. If you also want to recover well and get the benefits of the sauna, add <strong>€10</strong> for a full day of training and recovery: €25 in total.</p></details>
      </div>
    </div>
  </section>

  <section class="cta-block">
    <div class="bg" style="background-image:url('/assets/hero-climb.jpg')"></div>
    <div class="inner">
      <div class="eyebrow reveal" style="color:var(--bone-3)"><span class="num" style="color:var(--accent-hi)">04 —</span><span>Let's start</span></div>
      <h2 class="h-hero reveal">Your spot is<br>earned <em class="serif">today</em><span class="dot">.</span></h2>
      <p class="reveal">Tell us which exam you are preparing for and we'll get back to you with all the information. Or come to the free Thursday class with your registration proof.</p>
      <form id="opo-form" class="reveal" style="display:grid; gap:24px; max-width:560px;">
        <input type="text" name="website" style="position:absolute;left:-9999px;" tabindex="-1" autocomplete="off" aria-hidden="true" aria-label="Honeypot anti-spam">
        <div class="form-row two">
          <div class="field"><label for="o-name">Name</label><input id="o-name" type="text" name="name" required aria-required="true" placeholder="What's your name?"></div>
          <div class="field"><label for="o-phone">Phone</label><input id="o-phone" type="tel" name="phone" required aria-required="true" placeholder="629 ..."></div>
        </div>
        <div class="field"><label for="o-prep">Which exam are you preparing for?</label>
          <select id="o-prep" name="prep">
            <option>Bombers de la Generalitat (call 81/26)</option><option>Barcelona Firefighters (SPEIS)</option><option>Mossos d'Esquadra (Police)</option><option>Another exam</option>
          </select>
        </div>
        <div class="field"><label for="o-note">Any comments? (optional)</label><input id="o-note" type="text" name="note" placeholder="Exam call, test dates, questions..."></div>
        <div class="actions" style="margin-top:0;">
          <button type="submit" class="form-submit" id="opo-submit">Get info<span style="display:inline-block; width:20px; height:1px; background:currentColor;"></span></button>
          <a class="btn-ghost" href={WA} target="_blank" rel="noopener" data-wa="form">or via WhatsApp</a>
        </div>
        <p class="privacy-note" style="margin:14px 0 0;font-family:var(--f-mono);font-size:11px;letter-spacing:.04em;line-height:1.6;opacity:.75;max-width:62ch;">Data controller: TERRAWOD FITNESS, S.L. Purpose: to reply to your request. You can exercise your rights and read our <a href="/en/privacitat" style="color:inherit;text-decoration:underline;text-underline-offset:3px;">privacy policy</a>.</p>
        <div id="opo-msg" style="display:none; padding:20px; border-radius:8px; font-family:var(--f-display);"></div>
      </form>
    </div>
  </section>

  <Footer />

<script>
  import { initLeadForm, payloads } from '../../scripts/lead-form';
  // Handler compartit (src/scripts/lead-form.ts). El clic de WhatsApp el registra el Layout.
  initLeadForm({
