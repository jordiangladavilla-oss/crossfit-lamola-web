---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import Schema from '../../components/Schema.astro'

const partners = [
  {
    tag: '01 · Corporate access',
    name: 'Wellhub',
    desc: "Corporate wellbeing platform. If your company works with Wellhub, you can train at La Mola through your corporate plan.",
    url: 'https://wellhub.com/en-us/'
  },
  {
    tag: '02 · Corporate access',
    name: 'Urban Sports Club',
    desc: "One subscription, hundreds of sports venues. Access the box with your Urban Sports Club membership.",
    url: 'https://urbansportsclub.com/en/'
  },
  {
    tag: '03 · Athlete gear',
    name: 'Velites',
    desc: "Jump ropes, grips and training accessories. Official partner with perks for the La Mola community.",
    url: 'https://www.velitessport.com/'
  },
  {
    tag: '04 · Athlete gear',
    name: 'Picsil',
    desc: "Grips, chalk and CrossFit accessories made in Spain. Official partner with discounts for box athletes.",
    url: 'https://picsilsport.com/'
  },
  {
    tag: '05 · Equipment',
    name: 'Ruster Fitness',
    desc: "Plates, barbells and functional equipment. Much of the iron you lift every day at the box carries their mark.",
    url: 'https://rusterfitness.com/'
  },
  {
    tag: '06 · Equipment',
    name: 'Rogue Fitness',
    desc: "The global standard in strength equipment. La Mola's 15-station rig and part of its equipment is Rogue.",
    url: 'https://www.rogueeurope.eu/'
  }
]
---

<Layout
  title="Partners · CrossFit La Mola Terrassa"
  description="CrossFit La Mola's partners: Wellhub, Urban Sports Club, Velites, Picsil, Ruster Fitness and Rogue. The brands and platforms we build the Terrassa box with."
  ogImage="/assets/detail-dumbbells.webp"
>
  <Schema type="base" slot="head" />
  <Breadcrumb items={[{name: "Partners"}]} lang="en" slot="head" />
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "CrossFit La Mola partners",
      "itemListElement": [
        {"@type":"ListItem","position":1,"item":{"@type":"Organization","name":"Wellhub","url":"https://wellhub.com/en-us/"}},
        {"@type":"ListItem","position":2,"item":{"@type":"Organization","name":"Urban Sports Club","url":"https://urbansportsclub.com/en/"}},
        {"@type":"ListItem","position":3,"item":{"@type":"Organization","name":"Velites","url":"https://www.velitessport.com/"}},
        {"@type":"ListItem","position":4,"item":{"@type":"Organization","name":"Picsil","url":"https://picsilsport.com/"}},
        {"@type":"ListItem","position":5,"item":{"@type":"Organization","name":"Ruster Fitness","url":"https://rusterfitness.com/"}},
        {"@type":"ListItem","position":6,"item":{"@type":"Organization","name":"Rogue Fitness","url":"https://www.rogueeurope.eu/"}}
      ]
    }
    </script>
  </Fragment>

  <style>
    .partner-grid{ display:grid; gap:1px; margin-top:60px; background:var(--line); }
    @media(min-width:700px){ .partner-grid{ grid-template-columns:repeat(2,1fr);} }
    @media(min-width:1100px){ .partner-grid{ grid-template-columns:repeat(3,1fr);} }
    .partner{ background:var(--ink); padding:clamp(28px,3vw,40px); display:flex; flex-direction:column; gap:14px; transition:transform .35s cubic-bezier(.2,.8,.2,1);}
    .partner:hover{ transform:translateY(-3px);}
    .partner .tag{ font-family:var(--f-mono); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent-hi);}
    .partner h3{ font-family:var(--f-display); font-weight:500; font-size:clamp(24px,2.6vw,34px); letter-spacing:-0.03em; line-height:1; margin:0; color:var(--bone);}
    .partner p{ font-family:var(--f-serif); font-size:16.5px; line-height:1.55; color:var(--bone-2); margin:0; flex:1;}
    .partner a{ display:inline-flex; align-items:center; gap:10px; width:max-content;
      font-family:var(--f-mono); font-size:11px; letter-spacing:.2em; text-transform:uppercase;
      color:var(--bone); border-bottom:1px solid var(--accent-hi); padding-bottom:4px; transition:color .2s;}
    .partner a:hover{ color:var(--accent-hi);}
  </style>

  <Nav currentPage="/en/partners" />

  <section class="page-hero">
    <div class="bg" style="background-image:url('/assets/detail-chalk.jpg')"></div>
    <div class="inner">
      <div class="crumb"><a href="/en">Home</a><span>/</span><span>Partners</span></div>
      <div class="kicker"><span>Brands</span><span class="bar"></span><span>Platforms</span></div>
      <h1>Better<br><em class="serif">together</em><span class="dot">.</span></h1>
      <p class="sub">From the iron you lift to the platform that gets you in through your company plan: these are the brands and platforms we build La Mola with.</p>
    </div>
  </section>

  <section class="sec ink">
    <div class="inner">
      <div class="eyebrow reveal"><span class="num">01 —</span><span>Our partners</span></div>
      <div style="height:24px"></div>
      <div class="sec-head">
        <h2 class="h-xl reveal">Six names<br>we trust<span class="dot">.</span></h2>
        <p class="lead reveal">We choose partners like we choose equipment: because they hold up. Corporate access, equipment and athlete gear, all first-rate.</p>
      </div>

      <div class="partner-grid reveal-stagger">
        {partners.map((p, i) => (
          <div class="partner" style={`--i:${i}`}>
            <span class="tag">{p.tag}</span>
            <h3>{p.name}</h3>
            <p>{p.desc}</p>
            <a href={p.url} target="_blank" rel="noopener">Visit website →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-block">
    <div class="bg" style="background-image:url('/assets/hero-climb.jpg')"></div>
    <div class="inner">
      <div class="eyebrow reveal" style="color:var(--bone-3)"><span class="num" style="color:var(--accent-hi)">02 —</span><span>Let's talk</span></div>
      <h2 class="h-hero reveal">Want to be<br>a <em class="serif">partner</em><span class="dot">?</span></h2>
      <p class="reveal">If your brand fits the La Mola community, let's talk.</p>
      <div class="actions reveal">
        <a class="btn-primary" href="/en/contacte">Contact us<span class="arr"></span></a>
        <a class="btn-ghost" href="https://wa.me/34699196531" target="_blank" rel="noopener">or via WhatsApp</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
